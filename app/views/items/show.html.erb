<div class="flex justify-center items-start min-h-screen p-0 md:p-8">
  <div class="bg-white dark:bg-slate-800 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-3xl animate-in slide-in-from-bottom-5 duration-700">
    <!-- 画像ヘッダー -->
    <% if @item.image_url.present? %>
      <div class="flex justify-center bg-slate-50 dark:bg-slate-900 p-8 border-b border-slate-100 dark:border-slate-700">
        <img src="<%= @item.image_url %>" alt="<%= @item.title %>" class="w-48 h-48 object-cover rounded-lg shadow-md">
      </div>
    <% end %>

    <div class="p-5 md:p-8">
      <!-- タイトル -->
      <h1 class="text-2xl font-black text-slate-800 dark:text-slate-100 mb-2">
        <%= @item.title %>
      </h1>

      <!-- 発売日 -->
      <div class="text-slate-500 dark:text-slate-400 font-mono text-sm font-bold mb-6">
        <%= @item.release_date.strftime('%Y/%m/%d') %>
      </div>

      <!-- アーティスト -->
      <% if @item.artists.present? %>
        <div class="mb-6">
          <div class="flex flex-wrap gap-2">
            <% @item.artists.each do |artist_data| %>
              <% artist_label = artist_data['alias'].presence || artist_data['name'] %>
              <% if artist_data['old_key'].present? %>
                <%= link_to artist_label, "/#{artist_data['old_key']}.html", class: "inline-block px-3 py-1 rounded text-sm font-semibold bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900 dark:text-indigo-200 dark:hover:bg-indigo-800 transition-colors border border-indigo-200 dark:border-indigo-700" %>
              <% else %>
                <span class="inline-block px-3 py-1 rounded text-sm font-semibold bg-gray-50 text-gray-700 border border-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:border-gray-600"><%= artist_label %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>

      <!-- 購入リンク -->
      <div class="mb-8">
        <%= link_to @item.link_url, target: "_blank", rel: "noopener noreferrer",
            class: "inline-flex items-center gap-2 px-5 py-2.5 bg-indigo-600 hover:bg-indigo-700 dark:bg-indigo-500 dark:hover:bg-indigo-600 text-white font-bold rounded-lg transition-colors text-sm" do %>
          購入・詳細を見る
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
            <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" />
            <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" />
          </svg>
        <% end %>
      </div>

      <div class="pt-6 border-t border-slate-100 dark:border-slate-700">
        <% if defined?(logged_in?) && logged_in? %>
          <%= link_to "Edit", edit_admin_item_path(@item), class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors mr-4" %>
        <% end %>
        <%= link_to "Back to Items", items_path, class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors" %>
      </div>
    </div>
  </div>
</div>
