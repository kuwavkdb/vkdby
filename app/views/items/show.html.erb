<% content_for :title, [@item.title, @item.artists.map { |a| a['alias'].presence || a['name'] }.join(' / ')].reject(&:blank?).join(' / ') %>
<div class="flex justify-center items-start min-h-screen p-0 md:p-8">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <!-- ヘッダー（タイトル） -->
    <div class="bg-amber-500 p-6 md:p-8 border-b border-amber-600/30">
      <h1 class="text-xl font-black text-zinc-900 leading-snug flex flex-wrap items-center gap-2">
        <% @item.artists.each do |artist_data| %>
          <% artist_label = artist_data['alias'].presence || artist_data['name'] %>
          <% artist_path = artist_profile_path(artist_data) %>
          <% if artist_path %>
            <%= link_to artist_label, artist_path, class: "px-3 py-1 rounded-md text-sm font-bold bg-white/80 text-zinc-900 hover:bg-white/95 transition-colors border border-white/50" %>
          <% else %>
            <span class="px-3 py-1 rounded-md text-sm font-bold bg-white/50 text-zinc-900 border border-white/40"><%= artist_label %></span>
          <% end %>
        <% end %>
        <span><%= @item.title %></span>
      </h1>
    </div>

    <div class="p-5 md:p-8">
      <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 items-center max-w-2xl mx-auto">
        <!-- 画像（左） -->
        <% if @item.image_url.present? %>
          <div class="shrink-0">
            <% amazon_url = safe_url(@item.link_url) %>
            <% img_src, img_srcset, img_sizes =
                if amazon_image?(@item.image_url)
                  src = amazon_image_url(@item.image_url, 256)
                  srcset = [
                    "#{amazon_image_url(@item.image_url, 208)} 208w",
                    "#{amazon_image_url(@item.image_url, 256)} 256w",
                    "#{amazon_image_url(@item.image_url, 416)} 416w",
                    "#{amazon_image_url(@item.image_url, 512)} 512w",
                  ].join(", ")
                  [src, srcset, "(min-width: 640px) 208px, 256px"]
                else
                  [@item.image_url, nil, nil]
                end
            %>
            <% if amazon_url %>
              <%= link_to amazon_url, target: "_blank", rel: "noopener noreferrer" do %>
                <img src="<%= img_src %>" srcset="<%= img_srcset %>" sizes="<%= img_sizes %>"
                     width="256" height="256"
                     alt="<%= @item.title %>" class="w-64 h-64 sm:w-52 sm:h-52 object-scale-down shadow-md hover:opacity-90 transition-opacity">
              <% end %>
            <% else %>
              <img src="<%= img_src %>" srcset="<%= img_srcset %>" sizes="<%= img_sizes %>"
                   width="256" height="256"
                   alt="<%= @item.title %>" class="w-64 h-64 sm:w-52 sm:h-52 object-scale-down shadow-md">
            <% end %>
          </div>
        <% end %>

        <!-- 詳細（右） -->
        <div class="flex-1 min-w-0">

          <!-- 発売日 -->
          <div class="flex items-center justify-center sm:justify-start gap-2 mb-4">
            <span class="text-sm font-bold text-slate-500 dark:text-slate-400">発売日:</span>
            <%= link_to @item.release_date.strftime('%Y/%m/%d'),
                daily_path(year: @item.release_date.year, month: @item.release_date.month, day: @item.release_date.day),
                class: "font-mono text-sm font-bold text-slate-700 dark:text-slate-300 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
          </div>

          <!-- 購入・検索リンク -->
          <div class="flex flex-col gap-2">
            <% btn = "flex items-center justify-center sm:justify-start gap-2 px-4 py-2.5 font-bold rounded-lg transition-colors text-sm w-full sm:w-auto" %>
            <% sanitized_link_url = safe_url(@item.link_url) %>
            <% if sanitized_link_url %>
              <%= link_to sanitized_link_url, target: "_blank", rel: "noopener noreferrer",
                  class: "#{btn} bg-amber-500 hover:bg-amber-600 text-black" do %>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 shrink-0">
                  <path d="M2.25 2.25a.75.75 0 0 0 0 1.5h1.386c.17 0 .318.114.362.278l2.558 9.592a3.752 3.752 0 0 0-2.806 3.63c0 .414.336.75.75.75h15.75a.75.75 0 0 0 0-1.5H5.378A2.25 2.25 0 0 1 7.5 15h11.218a.75.75 0 0 0 .674-.421 60.358 60.358 0 0 0 2.96-7.228.75.75 0 0 0-.525-.965A60.864 60.864 0 0 0 5.68 4.509l-.232-.867A1.875 1.875 0 0 0 3.636 2.25H2.25ZM3.75 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0ZM16.5 20.25a1.5 1.5 0 1 1 3 0 1.5 1.5 0 0 1-3 0Z" />
                </svg>
                amazon.co.jp で購入
              <% end %>
            <% end %>

            <%
              artist_labels = @item.artists.map { |a| a['alias'].presence || a['name'] }
              title_keyword = @item.title.dup
              artist_labels.each do |label|
                if title_keyword.start_with?("#{label} ") || title_keyword.start_with?("#{label}　")
                  title_keyword = title_keyword.sub(/\A#{Regexp.escape(label)}[\s　]+/, '')
                  break
                end
              end
              search_keyword = [artist_labels.join(' '), title_keyword].reject(&:blank?).join(' ')
              tower_search_url = "https://tower.jp/search/item/#{ERB::Util.url_encode(search_keyword.gsub('.', ' '))}"
              tower_url = "//ck.jp.ap.valuecommerce.com/servlet/referral?sid=2143338&pid=881339479&vc_url=#{ERB::Util.url_encode(tower_search_url)}"
            %>
            <%= link_to tower_url, target: "_blank", rel: "noopener noreferrer",
                class: "#{btn} bg-yellow-400 hover:bg-yellow-500 text-red-700" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
              </svg>
              TOWER RECORDS ONLINE で検索
            <% end %>

            <%
              yahoo_search_url = "https://shopping.yahoo.co.jp/search?p=#{ERB::Util.url_encode(search_keyword)}"
              yahoo_url = "//ck.jp.ap.valuecommerce.com/servlet/referral?sid=2143338&pid=881475147&vc_url=#{ERB::Util.url_encode(yahoo_search_url)}"
            %>
            <%= link_to yahoo_url, target: "_blank", rel: "noopener noreferrer",
                class: "#{btn} bg-rose-500 hover:bg-rose-600 text-white" do %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0">
                <path fill-rule="evenodd" d="M9 3.5a5.5 5.5 0 1 0 0 11 5.5 5.5 0 0 0 0-11ZM2 9a7 7 0 1 1 12.452 4.391l3.328 3.329a.75.75 0 1 1-1.06 1.06l-3.329-3.328A7 7 0 0 1 2 9Z" clip-rule="evenodd" />
              </svg>
              Yahoo!ショッピング で検索
            <% end %>
          </div>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-700">
        <% if defined?(logged_in?) && logged_in? %>
          <%= link_to "Edit", edit_admin_item_path(@item), class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors mr-4" %>
        <% end %>
        <%= link_to "Back to Items", items_path, class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors" %>
      </div>

      <% if @related_items.any? %>
        <div class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-700">
          <%
            artist_names = @item.artists.map { |a| a['alias'].presence || a['name'] }.compact.join(' / ')
          %>
          <h2 class="text-base font-bold text-slate-600 dark:text-slate-400 mb-4"><%= artist_names %> の他の作品</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%= render ItemCardComponent.with_collection(@related_items) %>
          </div>
          <% if @related_items_count > 10 %>
            <% first_artist = @item.artists.find { |a| a['old_key'].present? || a['key'].present? } %>
            <%= render ArtistItemsButtonComponent.new(artist_name: artist_names, old_key: first_artist&.dig('old_key'), key: first_artist&.dig('key')) %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>
