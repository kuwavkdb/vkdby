<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-xl rounded-3xl overflow-hidden w-full max-w-2xl p-6 md:p-10 text-center">
    <p class="text-sm font-bold tracking-widest text-indigo-600 dark:text-indigo-400">404</p>
    <h1 class="mt-2 text-2xl md:text-3xl font-black text-zinc-800 dark:text-zinc-100">
      ページが見つかりません
    </h1>
    <p class="mt-4 text-zinc-500 dark:text-zinc-400">
      <%= Rails.application.config.site_name %> に、お探しのページは見つかりませんでした。<br>
      URLが正しいかご確認いただくか、以下から探してみてください。
    </p>

    <div class="mt-8">
      <%= form_with url: search_path, method: :get, local: true, class: "flex gap-2" do |f| %>
        <%= f.label :q, "検索", class: "sr-only" %>
        <%= f.text_field :q, value: @not_found_query, placeholder: "Search units and people...", class: "w-full bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl px-4 py-3 text-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-zinc-400", autofocus: true %>
        <%= f.button class: "bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-xl transition-colors shadow-sm hover:shadow-md flex items-center justify-center min-w-[3rem]" do %>
          <span class="sr-only">検索</span>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        <% end %>
      <% end %>
    </div>

    <% if Rails.application.config.google_cse_id.present? %>
      <div class="mt-4 flex items-center gap-3 text-xs font-medium text-zinc-400 dark:text-zinc-500">
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-700"></span>
        <span>または、Google検索で探す</span>
        <span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-700"></span>
      </div>
      <div class="mt-4 gcse-search"></div>
      <script async src="https://cse.google.com/cse.js?cx=<%= CGI.escape(Rails.application.config.google_cse_id) %>"></script>
    <% end %>

    <div class="mt-8 grid grid-cols-2 sm:grid-cols-3 gap-3 text-left">
      <%= link_to units_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        Units <span class="text-xs text-zinc-400">バンド</span>
      <% end %>
      <%= link_to people_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        People <span class="text-xs text-zinc-400">個人</span>
      <% end %>
      <%= link_to trends_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        Trends <span class="text-xs text-zinc-400">動向</span>
      <% end %>
      <%= link_to items_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        Items <span class="text-xs text-zinc-400">アイテム</span>
      <% end %>
      <%= link_to timeline_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        Timeline <span class="text-xs text-zinc-400">年表</span>
      <% end %>
      <%= link_to root_path, class: "flex items-center gap-2 rounded-xl border border-zinc-200 dark:border-zinc-700 px-4 py-3 text-sm font-medium text-zinc-600 dark:text-zinc-300 hover:border-indigo-400 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" do %>
        トップページ
      <% end %>
    </div>

    <%= content_for :errors_content_extra %>
  </div>
</div>

<div class="flex justify-center mt-6">
  <%= render 'layouts/google_adsense_square' %>
</div>
