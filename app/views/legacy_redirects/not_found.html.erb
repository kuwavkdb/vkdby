<% content_for :title, "ページが見つかりません" %>

<% if logged_in? && @unit_name.present? %>
  <% content_for :errors_content_extra do %>
    <div class="mt-8 p-5 rounded-2xl bg-zinc-50 dark:bg-zinc-800 text-left">
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        管理者用メニュー:<br>
        <strong class="text-zinc-800 dark:text-zinc-100"><%= @unit_name %></strong> はまだデータベースに登録されていません。
      </p>
      <div class="mt-3">
        <%= link_to "このユニットを作成する", new_admin_unit_path(name: @unit_name, old_key: @old_key), class: "inline-block rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 text-sm font-bold transition-colors" %>
      </div>
    </div>
  <% end %>
<% end %>

<%= render 'errors/content' %>
