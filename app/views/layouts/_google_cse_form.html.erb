<%# Google Custom Search Engine(cse.google.com)へのリンク型検索フォーム。
    404ページ・横断検索ページから共通で呼び出す。
    locals:
      query      - 検索フォームの初期値(省略可)
      autofocus  - 検索欄にautofocusを付けるか(省略時false) %>
<% if Rails.application.config.google_cse_id.present? %>
  <%= form_with url: "https://cse.google.com/cse", method: :get, local: true, class: "flex gap-2" do |f| %>
    <%= f.hidden_field :cx, value: Rails.application.config.google_cse_id %>
    <%= f.label :q, "Google検索", class: "sr-only" %>
    <%= f.text_field :q, value: local_assigns[:query], placeholder: "Google search vkdb.jp...", class: "w-full bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl px-4 py-3 text-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-zinc-400", autofocus: local_assigns[:autofocus] || false %>
    <%= f.button class: "bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-3 rounded-xl transition-colors shadow-sm hover:shadow-md flex items-center justify-center gap-2 whitespace-nowrap" do %>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
      </svg>
      <span>Google検索</span>
    <% end %>
  <% end %>
<% end %>
