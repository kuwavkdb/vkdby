<div class="flex justify-center items-center min-h-screen p-0 md:p-8">
  <div class="bg-white dark:bg-slate-800 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <div class="bg-slate-50 dark:bg-slate-900/30 p-6 md:p-8 border-b border-slate-100 dark:border-slate-700">
      <div class="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400 font-mono mb-2 font-bold">
        <%= @trend.date.strftime('%Y/%m/%d') %>
      </div>
      <h1 class="text-2xl font-bold text-slate-800 dark:text-slate-100">
        <% if @trend.units %>
          <% @trend.units.each do |unit_data| %>
            <% unit = @related_units&.dig(unit_data['unit_id']) %>
            <% if unit %>
              <%= link_to unit.name, profile_path(unit.key), class: "inline-block px-3 py-1 rounded-md text-lg font-semibold bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900/30 dark:text-indigo-300 dark:hover:bg-indigo-900/50 transition-colors mr-2 border border-indigo-200 dark:border-indigo-800 align-middle" %>
            <% elsif unit_data['name'].present? %>
              <span class="inline-block px-3 py-1 rounded-md text-lg font-semibold bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400 mr-2 border border-slate-200 dark:border-slate-700 align-middle"><%= unit_data['name'] %></span>
            <% end %>
          <% end %>
        <% end %>
        <%= format_wiki_title(@trend.title, link: false) %>
      </h1>
    </div>
    <div class="p-5 md:p-8">

      <div class="prose prose-slate dark:prose-invert max-w-none">
        <%= format_wiki_content(@trend.content) %>

        <% if @trend.quote.present? %>
          <% if twitter_url?(@trend.quote_url) %>
            <div class="mt-8 flex justify-center">
              <%= twitter_embed(@trend.quote_url, @trend.quote) %>
            </div>
          <% else %>
            <blockquote class="mt-8 border-l-4 border-indigo-500 pl-4 py-1 bg-slate-50 dark:bg-slate-800/50 rounded-r-lg">
              <div class="text-lg italic text-slate-700 dark:text-slate-300">
                <%= simple_format(@trend.quote) %>
              </div>
              <% if @trend.quote_title.present? || @trend.quote_url.present? %>
                <cite class="block mt-2 text-sm font-bold text-slate-500 dark:text-slate-400 not-italic">
                  —
                  <% if @trend.quote_url.present? %>
                    <% sanitized_url = safe_url(@trend.quote_url) %>
                    <% if sanitized_url %>
                      <%= link_to @trend.quote_title.presence || sanitized_url, sanitized_url, target: '_blank', rel: 'noopener noreferrer', class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
                    <% else %>
                      <%= @trend.quote_title.presence || @trend.quote_url %>
                    <% end %>
                  <% else %>
                    <%= @trend.quote_title %>
                  <% end %>
                </cite>
              <% end %>
            </blockquote>
          <% end %>
        <% end %>
      </div>
      
      <div class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-700">
        <% if defined?(logged_in?) && logged_in? %>
          <%= link_to "Edit", edit_admin_trend_path(@trend), class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors mr-4" %>
        <% end %>
        <%= link_to "Back to Trends", trends_path, class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors" %>
      </div>
    </div>
  </div>
</div>
