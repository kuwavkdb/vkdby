<%
  # ページタイトル（<title>タグ、og:title/twitter:titleも同じ値を流用）に日付とユニット名を含める（issue #1319）。
  # Trend#units のスナップショット名（trend_unit_display_name）を優先し、
  # 表示順は ユニット名 → タイトル（動向） → 日付。個人名は含めない
  trend_title_unit_names = (@trend.units || []).filter_map do |unit_data|
    trend_unit_display_name(unit_data, @related_units&.dig(unit_data['unit_id']))
  end
  trend_title_text = trend_title_without_trailing_parenthetical(
    strip_tags(format_wiki_title(@trend.title, link: false))
  ).presence
%>
<% content_for :title, [*trend_title_unit_names, trend_title_text,
                        trend_date_label(@trend)].compact_blank.join(' ') %>
<%# ユニット名/タイトル入りのog:image（issue #1319、Unit/Personのプロフィールページ向け実装
    issue #1259と同じ仕組み）。生成できない場合（libvips未導入等）はogp_image_relative_urlがnilを返し、
    application_helper#og_image_urlのデフォルト画像フォールバックに任せる %>
<% if (ogp_image_path = @trend.ogp_image_relative_url) %>
  <% content_for :og_image, "#{request.base_url}#{ogp_image_path}" %>
<% end %>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <div class="bg-amber-500 p-6 md:p-8 border-b border-amber-600/30 relative">
      <%= render HeaderActionLinkComponent.new(label: "Edit", url: edit_admin_trend_path(@trend),
            visible: defined?(logged_in?) && logged_in?) %>
      <%# ヘッダの日付はtext-amber-900だとbg-amber-500背景とのコントラスト比が約4.2:1でWCAG AA（4.5:1）未達だった。
          タイトル（h1）と同じtext-zinc-900に揃えてコントラスト比を約8.3:1まで改善（issue #1322） %>
      <div class="flex items-center gap-3 text-sm text-zinc-900 font-mono mb-2 font-bold">
        <% date_path = if @trend.month_unknown?
                         yearly_path(year: @trend.date.year)
                       elsif @trend.day_unknown?
                         monthly_path(year: @trend.date.year, month: @trend.date.month)
                       else
                         daily_path(year: @trend.date.year, month: @trend.date.month, day: @trend.date.day)
                       end %>
        <%= link_to trend_date_label(@trend), date_path, class: "hover:underline transition-colors" %>
      </div>
      <% person_badge_in_title = trend_show_person_badge_in_title?(@trend) %>
      <h1 class="text-2xl font-bold text-zinc-900 flex flex-wrap items-center gap-2">
        <% if @trend.units %>
          <% @trend.units.each do |unit_data| %>
            <% unit = @related_units&.dig(unit_data['unit_id']) %>
            <% display_name = trend_unit_display_name(unit_data, unit) %>
            <% if unit %>
              <%= link_to display_name, profile_path(unit.key), class: "px-3 py-1 rounded-md text-lg font-bold bg-white/80 text-zinc-900 hover:bg-white/95 transition-colors border border-white/50" %>
            <% elsif display_name.present? %>
              <span class="px-3 py-1 rounded-md text-lg font-bold bg-white/50 text-zinc-900 border border-white/40"><%= display_name %></span>
            <% end %>
          <% end %>
        <% end %>
        <%# 個人の動向種別が設定されていてユニット未紐付けの場合、ユニットバッヂと同じ位置・スタイルで
            個人名バッヂを件名の前に表示する（issue #1411） %>
        <% if person_badge_in_title %>
          <% @trend.people.each do |person_data| %>
            <% person = @related_people&.dig(person_data['person_id']) %>
            <% display_name = trend_person_display_name(person_data, person) %>
            <% if person %>
              <%= link_to display_name, profile_path(person.key), class: "px-3 py-1 rounded-md text-lg font-bold bg-white/80 text-zinc-900 hover:bg-white/95 transition-colors border border-white/50" %>
            <% elsif display_name.present? %>
              <span class="px-3 py-1 rounded-md text-lg font-bold bg-white/50 text-zinc-900 border border-white/40"><%= display_name %></span>
            <% end %>
          <% end %>
        <% end %>
        <span><%= format_wiki_title(@trend.title, link: false) %></span>
      </h1>
      <% if @trend.people.present? && !person_badge_in_title %>
        <div class="mt-2 flex flex-wrap items-center gap-1">
          <% @trend.people.each do |person_data| %>
            <% person = @related_people&.dig(person_data['person_id']) %>
            <% display_name = trend_person_display_name(person_data, person) %>
            <% if person %>
              <%= link_to display_name, profile_path(person.key), class: "px-2 py-0.5 rounded text-sm font-medium bg-white/60 text-zinc-800 hover:bg-white/80 transition-colors border border-white/40" %>
            <% elsif display_name.present? %>
              <span class="px-2 py-0.5 rounded text-sm font-medium bg-white/40 text-zinc-800 border border-white/30"><%= display_name %></span>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
    <div class="p-5 md:p-8">

      <div class="prose prose-slate dark:prose-invert max-w-none">
        <%= format_wiki_content(@trend.content) %>

        <% if @trend.quote.present? %>
          <% if twitter_url?(@trend.quote_url) %>
            <div class="mt-8 flex justify-center">
              <%= twitter_embed(@trend.quote_url, @trend.quote) %>
            </div>
          <% else %>
            <blockquote class="mt-8 relative pl-10 pr-4 py-4 bg-slate-50 dark:bg-slate-800/50 rounded-xl border border-slate-200 dark:border-slate-700">
              <span class="absolute top-2 left-3 text-5xl leading-none text-indigo-300 dark:text-indigo-600 font-serif select-none" aria-hidden="true">&ldquo;</span>
              <div class="text-base italic text-slate-700 dark:text-slate-300">
                <%= simple_format(@trend.quote) %>
              </div>
              <% if @trend.quote_title.present? || @trend.quote_url.present? %>
                <cite class="block mt-2 text-sm font-bold text-slate-500 dark:text-slate-400 not-italic">
                  —
                  <% if @trend.quote_url.present? %>
                    <% sanitized_url = safe_url(@trend.quote_url) %>
                    <% if sanitized_url %>
                      <%= link_to @trend.quote_title.presence || sanitized_url, sanitized_url, target: '_blank', rel: 'noopener noreferrer', class: "hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
                    <% else %>
                      <%= @trend.quote_title.presence || @trend.quote_url %>
                    <% end %>
                  <% else %>
                    <%= @trend.quote_title %>
                  <% end %>
                </cite>
              <% end %>
            </blockquote>
          <% end %>
        <% end %>
      </div>
      
      <% if @snapshot || @unit_trends.present? %>
        <div class="mt-10 grid gap-8 grid-cols-1 md:grid-cols-[1fr_360px] items-start">
          <% if @snapshot %>
            <section>
              <div class="flex items-center gap-2 mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
                <h2 class="flex items-baseline gap-1.5">
                  <%= link_to trend_unit_display_name(@trend.units.first, @unit), profile_path(@unit.key), class: "text-sm font-bold text-slate-800 dark:text-slate-200 hover:text-indigo-600 dark:hover:text-indigo-400 transition-colors" %>
                  <span class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Members</span>
                </h2>
                <% if @snapshot.label.present? && @trend.snapshot_date.blank? %>
                  <span class="text-xs font-black px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400"><%= @snapshot.label %></span>
                <% end %>
                <% if @snapshot.current? %>
                  <span class="text-xs font-black uppercase px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400">Current</span>
                <% end %>
              </div>
              <div class="flex flex-col border border-slate-200 dark:border-slate-700 rounded-2xl overflow-hidden shadow-sm">
                <%= render MemberRowComponent.with_collection(@snapshot.snapshot_people.sort_by(&:sort_order), hide_active: true, hide_status: @snapshot.past?) %>
              </div>
            </section>
          <% else %>
            <div></div>
          <% end %>

          <%= render UnitTrendsComponent.new(trends: @unit_trends, current_trend_id: @trend.id, top_spacing: false, resource: @unit, related_units: @unit_trends_related_units) %>
        </div>
      <% end %>

      <% if @items.present? %>
        <section class="mt-8">
          <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
            <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Recent Items (Max 8)</h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <%= render ItemCardComponent.with_collection(@items) %>
          </div>
        </section>
      <% end %>

      <% if defined?(logged_in?) && logged_in? %>
        <section class="mt-8 pt-6 border-t border-slate-100 dark:border-slate-700">
          <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">X（Twitter）シェア用テキスト（管理者のみ表示）</h2>
          <div class="flex items-start gap-2">
            <textarea id="trend-x-share-text"
                      readonly
                      rows="4"
                      class="flex-1 text-sm font-mono rounded-lg border border-slate-300 dark:border-slate-600 bg-slate-50 dark:bg-slate-800 text-slate-800 dark:text-slate-200 px-3 py-2"
                      aria-label="Xシェア用テキスト"><%= trend_x_share_text(@trend, related_units: @related_units || {}, related_people: @related_people || {}) %></textarea>
            <button type="button"
                    onclick="navigator.clipboard.writeText(document.getElementById('trend-x-share-text').value).then(() => { this.textContent = 'コピー済み'; setTimeout(() => this.textContent = 'コピー', 2000) })"
                    class="text-xs px-2 py-1 border border-slate-300 dark:border-slate-600 rounded text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-indigo-500"
                    aria-label="Xシェア用テキストをクリップボードにコピー">
              コピー
            </button>
          </div>
        </section>
      <% end %>

      <div class="mt-12 pt-8 border-t border-slate-100 dark:border-slate-700">
        <%= link_to "Back to Trends", trends_path, class: "text-sm font-bold text-indigo-500 hover:text-indigo-600 dark:text-indigo-400 dark:hover:text-indigo-300 transition-colors" %>
      </div>
    </div>
  </div>
</div>
