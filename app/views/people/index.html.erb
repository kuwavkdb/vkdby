<% content_for :title, "個人一覧" %>
<%# 説明文の絞り込み条件は、個人の項目（パート→出身地→状況→血液型）のあとに、選んだタグを絞り込みグループの順で続ける
    （issue #1959）。コントローラは tag_ids のキーに関係なく値で絞り込むので、タグは値（id）で探す %>
<% selected_tag_ids = @selected_tag_ids.values.map(&:to_s) %>
<% selected_tag_names = @filter_groups.flat_map do |group|
     group.tag_indices.select { |tag| selected_tag_ids.include?(tag.id.to_s) }.sort_by { |tag| tag.order_in_group.to_i }.map(&:short_name)
   end %>
<% condition_names = people_index_filter_names(part: @selected_part, hometown: @selected_hometown,
                                               status: @selected_status, blood: @selected_blood) + selected_tag_names %>
<% if params[:q].present? %>
  <%# 検索語は利用者が自由に入れられ、説明文にも入るため、検索語付きのページは検索エンジンに載せない（issue #1959） %>
  <% content_for :head do %>
    <meta name="robots" content="noindex, follow">
  <% end %>
<% end %>
<% people_description = people_index_meta_description(
     total: @total_person_count, filtered_count: (@pagy.count if @filtered),
     query: params[:q], condition_names:, page: @pagy.page
   ) %>
<% content_for :description, people_description %>
<div class="flex justify-center">
  <div class="bg-white dark:bg-slate-800 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700 p-5 md:p-8">
    <header class="mb-8 text-center flex flex-col items-center">
      <h1 class="text-3xl font-black text-zinc-800 dark:text-zinc-100 flex items-center justify-center gap-3">
        <span class="text-person">PEOPLE</span>
      </h1>
      <%# meta description と同じ文を見出しの下に表示する。件数もこの文で示す（issue #1959） %>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-300"><%= people_description %></p>
    </header>

    <%# キーワード以外の絞り込みは、指定がないときは折りたたむ（issue #1921） %>
    <% has_filters = @filter_groups.present? || @person_data_filters.any? { |filter| filter[:options].any? { |o| o[:count].to_i.positive? } } %>
    <div data-controller="disclosure">
    <div class="mb-6">
      <%= form_with url: people_path, method: :get, local: true, class: "flex gap-2" do |f| %>
        <div class="relative w-full"
             data-controller="search-suggest"
             data-search-suggest-url-value="<%= search_people_path %>"
             data-search-suggest-profile-base-value="">
          <%= f.text_field :q, value: params[:q], placeholder: "Search people...",
              class: "w-full bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-700 rounded-xl px-4 py-3 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 transition-all placeholder:text-slate-400",
              data: {
                search_suggest_target: "input",
                action: "input->search-suggest#onInput keydown->search-suggest#onKeydown"
              } %>
          <div data-search-suggest-target="suggestions"
               style="position: fixed;"
               class="hidden z-50 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-lg overflow-y-auto max-h-80">
          </div>
        </div>
        <% if has_filters %>
          <button type="button"
                  data-disclosure-target="button"
                  data-action="disclosure#toggle"
                  aria-expanded="<%= @filters_open %>"
                  aria-controls="people-filters"
                  aria-label="詳細検索"
                  title="詳細検索"
                  class="bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-700 text-zinc-600 dark:text-zinc-300 hover:bg-zinc-100 dark:hover:bg-zinc-800 aria-expanded:bg-indigo-50 aria-expanded:text-indigo-700 aria-expanded:border-indigo-300 dark:aria-expanded:bg-amber-400/10 dark:aria-expanded:text-amber-400 dark:aria-expanded:border-amber-400/60 p-3 rounded-xl transition-colors flex items-center justify-center min-w-[3rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-slate-800">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6h9.75M10.5 6a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0M3.75 6H7.5m3 12h9.75m-9.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-3.75 0H7.5m9-6h3.75m-3.75 0a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m-9.75 0h9.75" />
            </svg>
          </button>
        <% end %>
        <%= f.button "aria-label": "検索", class: "bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-xl transition-colors shadow-sm hover:shadow-md flex items-center justify-center min-w-[3rem]" do %>
           <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
        <% end %>
      <% end %>
    </div>

    <div id="people-filters" data-disclosure-target="panel" <%= "hidden" unless @filters_open %>>
    <% if @filter_groups.present? %>
      <div class="mb-8 space-y-2">
        <% @filter_groups.each do |group| %>
          <div class="flex flex-wrap gap-1">
            <%
              current_tag_ids = @selected_tag_ids
              group_selected = current_tag_ids[group.id.to_s].present?
              clear_params = current_tag_ids.except(group.id.to_s)
              common_params = { q: params[:q], part: @selected_part, blood: @selected_blood, hometown: @selected_hometown, status: @selected_status }
            %>
            <% unless [1, 2].include?(group.id) %>
              <span class="py-1 text-xs font-semibold text-slate-500 uppercase tracking-wide self-center"><%= group.name %> :</span>
            <% end %>
            <%= link_to people_path(common_params.merge(tag_ids: clear_params)), class: "px-2 py-1 rounded-lg text-sm font-bold transition-all #{group_selected ? 'bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600' : 'bg-indigo-600 text-white shadow-md'}" do %>
              ALL
            <% end %>
            <% group.tag_indices.active.ordered.each do |tag| %>
              <%
                new_tag_ids = current_tag_ids.merge(group.id.to_s => tag.id.to_s)
                is_selected = current_tag_ids[group.id.to_s].to_s == tag.id.to_s
              %>
              <%= link_to people_path(common_params.merge(tag_ids: new_tag_ids)), class: "px-2 py-1 rounded-lg text-sm font-bold transition-all #{is_selected ? 'bg-indigo-600 text-white shadow-md' : 'bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600'}" do %>
                <%= tag.short_name %>
                <span class="ml-1 opacity-70 text-xs font-normal">(<%= @tag_person_counts[tag.id] || 0 %>)</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if @person_data_filters.present? %>
      <div class="mb-8 space-y-2">
        <% @person_data_filters.each do |filter| %>
          <% options = filter[:options].reject { |o| o[:count].to_i.zero? } %>
          <% next if options.empty? %>
          <div class="flex flex-wrap gap-1">
            <%
              base_params = { q: params[:q], tag_ids: @selected_tag_ids, part: @selected_part, blood: @selected_blood, hometown: @selected_hometown, status: @selected_status }
              group_selected = filter[:selected].present?
            %>
            <span class="py-1 text-xs font-semibold text-slate-500 uppercase tracking-wide self-center"><%= filter[:name] %> :</span>
            <%= link_to people_path(base_params.merge(filter[:param] => nil)), class: "px-2 py-1 rounded-lg text-sm font-bold transition-all #{group_selected ? 'bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600' : 'bg-indigo-600 text-white shadow-md'}" do %>
              ALL
            <% end %>
            <% options.each do |option| %>
              <% is_selected = filter[:selected] == option[:value] %>
              <%= link_to people_path(base_params.merge(filter[:param] => option[:value])), class: "px-2 py-1 rounded-lg text-sm font-bold transition-all #{is_selected ? 'bg-indigo-600 text-white shadow-md' : 'bg-white dark:bg-slate-700 text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-600'}" do %>
                <%= option[:label] %>
                <span class="ml-1 opacity-70 text-xs font-normal">(<%= option[:count] %>)</span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
    </div>
    </div>

    <% if @people.any? %>
      <div id="results" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <%= render PersonCardComponent.with_collection(@people, show_history: true, show_details: true) %>
      </div>
    <% elsif @unlinked_members.none? %>
      <div class="py-20 text-center">
        <p class="text-slate-500 font-bold">検索結果が見つかりませんでした。</p>
      </div>
    <% end %>

    <%# 個人ページのないメンバーは個人ページのある人より優先度が低いため、個人の一覧の下に出す（issue #1843） %>
    <% if @unlinked_members.any? %>
      <section class="<%= @people.any? ? 'mt-10' : '' %>" aria-labelledby="unlinked-members-heading">
        <h2 id="unlinked-members-heading" class="mb-4 text-sm font-bold text-zinc-600 dark:text-zinc-300">個人ページのないメンバー</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
          <%= render UnlinkedMemberCardComponent.with_collection(@unlinked_members) %>
        </div>
      </section>
    <% end %>

    <div class="mt-8 flex justify-center">
      <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
    </div>
  </div>
</div>
