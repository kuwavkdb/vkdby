<section id="relationship-graph" class="mt-8"
  data-controller="unit-graph"
  data-unit-graph-url-value="<%= profile_relationship_graph_path(unit.key) %>">

  <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
    <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Relationship Graph</h2>
    <div class="flex items-center gap-3">
      <span data-unit-graph-target="nodeCount" class="text-xs text-slate-400 dark:text-slate-500 hidden"></span>
      <button
        data-unit-graph-target="fullscreenBtn"
        data-action="click->unit-graph#toggleFullscreen"
        class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 transition-colors hidden p-2 -m-2"
        style="touch-action:manipulation;"
        aria-label="全画面表示">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
        </svg>
      </button>
    </div>
  </div>

  <%# 初期表示: ボタンのみ %>
  <div data-unit-graph-target="placeholder" class="flex justify-center py-8">
    <button
      data-action="click->unit-graph#load"
      class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 rounded-lg transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 14.25v2.25m3-4.5v4.5m3-6.75v6.75m3-9v9M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
      </svg>
      関連図を表示
    </button>
  </div>

  <%# グラフ表示領域（初期非表示）%>
  <div data-unit-graph-target="graphArea" class="hidden">
    <div style="display:flex;flex-wrap:wrap;align-items:center;gap:0.75rem;margin-bottom:0.75rem;font-size:0.75rem;color:#64748b;">
      <span style="display:flex;align-items:center;gap:0.375rem;">
        <span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:2px;background:#dc2626;" aria-hidden="true"></span>
        このユニット
      </span>
      <span style="display:flex;align-items:center;gap:0.375rem;">
        <span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:2px;background:#6366f1;" aria-hidden="true"></span>
        直接の関連ユニット
      </span>
      <span style="display:flex;align-items:center;gap:0.375rem;color:#94a3b8;">
        <span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:2px;background:#94a3b8;" aria-hidden="true"></span>
        間接の関連ユニット
      </span>
      <span style="display:flex;align-items:center;gap:0.375rem;color:#64748b;">
        <svg width="24" height="8" aria-hidden="true"><line x1="0" y1="4" x2="24" y2="4" stroke="#64748b" stroke-width="2"/></svg>
        現在の関連
      </span>
      <span style="display:flex;align-items:center;gap:0.375rem;color:#94a3b8;">
        <svg width="24" height="8" aria-hidden="true"><line x1="0" y1="4" x2="24" y2="4" stroke="#94a3b8" stroke-width="1.5" stroke-dasharray="4 3"/></svg>
        過去/サポートの関連
      </span>
      <label style="display:flex;align-items:center;gap:0.375rem;cursor:pointer;user-select:none;margin-left:auto;">
        <input type="checkbox"
          data-unit-graph-target="trackPast"
          data-action="change->unit-graph#toggleTrackPast"
          class="rounded border-slate-300 dark:border-slate-600 text-indigo-500 focus:ring-indigo-400"
          aria-label="過去/サポートメンバーを含む">
        過去/サポートを含む
      </label>
    </div>
    <div
      data-unit-graph-target="container"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900"
      style="height: 420px; position: relative;"
      role="img"
      aria-label="<%= unit.name %> のメンバー関連図">
    </div>
  </div>

</section>
