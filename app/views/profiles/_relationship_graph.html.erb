<% node_count = graph_data[:nodes].length %>
<% if node_count > 1 %>
  <section class="mt-8">
    <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
      <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400">Relationship Graph</h2>
      <span class="text-xs text-slate-400 dark:text-slate-500"><%= node_count %> nodes</span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-bottom:0.75rem;font-size:0.75rem;color:#64748b;">
      <span style="display:flex;align-items:center;gap:0.375rem;">
        <span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:2px;background:#dc2626;" aria-hidden="true"></span>
        このユニット
      </span>
      <span style="display:flex;align-items:center;gap:0.375rem;">
        <span style="display:inline-block;width:0.75rem;height:0.75rem;border-radius:2px;background:#6366f1;" aria-hidden="true"></span>
        関連ユニット
      </span>
    </div>
    <div
      data-controller="unit-graph"
      data-unit-graph-data-value="<%= html_escape(graph_data.to_json) %>"
      class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900"
      style="height: 420px;"
      role="img"
      aria-label="<%= unit.name %> のメンバー関連図">
    </div>
  </section>
<% end %>
