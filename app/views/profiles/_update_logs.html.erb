<% if update_logs.present? %>
  <ol class="space-y-1" aria-label="更新ログ">
    <% update_logs.each do |log| %>
      <li class="flex items-center gap-3 text-xs text-slate-500 dark:text-slate-400">
        <time datetime="<%= log.created_at.iso8601 %>" class="shrink-0 tabular-nums">
          <%= log.created_at.strftime('%Y-%m-%d %H:%M') %>
        </time>
        <% label, cls = case log.action
                         when 'create'    then ['作成', 'bg-green-100 text-green-700 dark:bg-green-900/50 dark:text-green-300']
                         when 'update'    then ['更新', 'bg-blue-100 text-blue-700 dark:bg-blue-900/50 dark:text-blue-300']
                         when 'discard'   then ['削除', 'bg-red-100 text-red-700 dark:bg-red-900/50 dark:text-red-300']
                         when 'undiscard' then ['復元', 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/50 dark:text-yellow-300']
                         end %>
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[0.65rem] font-medium <%= cls %>"><%= label %></span>
        <% loggable_label = { 'UnitSnapshot' => 'スナップショット', 'SnapshotPerson' => 'メンバー', 'Link' => 'リンク', 'Section' => 'セクション' }[log.loggable_type] %>
        <% if loggable_label %>
          <% detail = case log.loggable_type
                      when 'Section'
                        section = log.loggable
                        section&.discarded? ? '（削除済みセクション）' : (section&.name || log.diff&.dig('name', 1))
                      when 'SnapshotPerson'
                        sp = log.loggable
                        if sp
                          sp_part = sp.part_alias.presence || sp.part.humanize
                          "#{sp.name} (#{sp_part})"
                        end
                      end %>
          <span class="text-slate-300 dark:text-slate-600">[<%= loggable_label %><%= ": #{detail}" if detail %>]</span>
        <% end %>
        <span class="text-slate-400 dark:text-slate-500"><%= log.user.name %></span>
      </li>
    <% end %>
  </ol>
<% else %>
  <p class="text-xs text-slate-400 dark:text-slate-500">更新ログはありません</p>
<% end %>
