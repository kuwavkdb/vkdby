<% content_for :title, "動向情報を投稿する" %>
<% fixed_target = @trend_submission.target_id.present? %>
<div class="flex justify-center">
  <div class="bg-white dark:bg-slate-800 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-3xl animate-in slide-in-from-bottom-5 duration-700 p-5 md:p-8">
    <header class="mb-8 text-center flex flex-col items-center">
      <h1 class="text-3xl font-black text-slate-800 dark:text-slate-100">動向情報を投稿する</h1>
      <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 max-w-xl">
        <% if fixed_target %>
          <strong><%= @trend_submission.target_name %></strong> に関する動向情報をお寄せください。ログインは不要です。<br>
        <% else %>
          ユニット（バンド）・個人に関する動向情報をお寄せください。ログインは不要です。<br>
        <% end %>
        いただいた内容は管理者が確認したうえで掲載を検討します（内容がそのまま公開されるわけではありません）。出典URLのない投稿は受け付けられません。
      </p>
    </header>

    <% if @trend_submission.errors.any? %>
      <div class="mb-6 p-4 text-sm text-red-700 bg-red-50 dark:bg-red-900/40 dark:text-red-200 rounded-xl" role="alert">
        <p class="font-bold mb-1"><%= pluralize(@trend_submission.errors.count, "件") %>の入力エラーがあります：</p>
        <ul class="list-disc list-inside">
          <% @trend_submission.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with model: @trend_submission, url: trend_submissions_path, local: true, class: "space-y-6",
          data: { controller: "trend-submission-target" } do |form| %>
      <% if fixed_target %>
        <%= form.hidden_field :target_type %>
        <%= form.hidden_field :target_id %>
        <%= form.hidden_field :target_name %>
        <div>
          <span class="block text-sm font-bold text-slate-700 dark:text-slate-200">投稿対象</span>
          <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">
            <%= @trend_submission.target_name %>（<%= @trend_submission.target_type == 'unit' ? 'ユニット（バンド）' : '個人' %>）
          </p>
        </div>
      <% else %>
        <fieldset>
          <legend class="block text-sm font-bold text-slate-700 dark:text-slate-200">対象種別</legend>
          <span class="text-red-500 text-xs align-top">必須</span>
          <div class="mt-2 flex flex-wrap gap-4">
            <label class="inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200">
              <%= form.radio_button :target_type, :unit, required: true,
                    checked: @trend_submission.target_type.blank? || @trend_submission.target_type == 'unit',
                    data: { trend_submission_target_target: "typeRadio", action: "change->trend-submission-target#sync" } %>
              ユニット（バンド）
            </label>
            <label class="inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200">
              <%= form.radio_button :target_type, :person, required: true,
                    checked: @trend_submission.target_type == 'person',
                    data: { trend_submission_target_target: "typeRadio", action: "change->trend-submission-target#sync" } %>
              個人
            </label>
          </div>
        </fieldset>

        <div>
          <%= form.label :target_name, "対象名（ユニット名または個人名）", class: "block text-sm font-bold text-slate-700 dark:text-slate-200" %>
          <span class="text-red-500 text-xs align-top">必須</span>
          <%= form.text_field :target_name, required: true,
              class: "mt-1 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">サイト内での紐付けは管理者が承認時に行います。表記ゆれがあっても構いません。</p>
        </div>
      <% end %>

      <fieldset>
        <legend class="block text-sm font-bold text-slate-700 dark:text-slate-200">日付</legend>
        <span class="text-red-500 text-xs align-top">必須</span>
        <div class="mt-2 flex flex-wrap items-center gap-4">
          <%= form.date_field :date, required: true,
              class: "rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
          <label class="inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200">
            <%= form.check_box :day_unknown, class: "rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-500" %>
            日不明
          </label>
          <label class="inline-flex items-center gap-1.5 text-sm text-slate-700 dark:text-slate-200">
            <%= form.check_box :month_unknown, class: "rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-500" %>
            月不明
          </label>
        </div>
      </fieldset>

      <% if fixed_target %>
        <% target_type = @trend_submission.target_type %>
        <fieldset>
          <legend class="block text-sm font-bold text-slate-700 dark:text-slate-200">動向種別</legend>
          <span class="text-red-500 text-xs align-top">必須</span>
          <%= form.select :phenomenon,
              options_for_select(TrendSubmission.phenomenon_options_for(target_type).map { |k| [I18n.t("activerecord.attributes.trend.#{target_type}_phenomenon.#{k}"), Trend.public_send("#{target_type}_phenomenons")[k]] }, @trend_submission.phenomenon),
              { include_blank: "選択してください" },
              required: true,
              class: "mt-2 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </fieldset>
      <% else %>
        <fieldset data-trend-submission-target-target="unitPhenomenon">
          <legend class="block text-sm font-bold text-slate-700 dark:text-slate-200">ユニットの動向種別</legend>
          <span class="text-red-500 text-xs align-top">必須</span>
          <%= form.select :phenomenon,
              options_for_select(Trend.unit_phenomenons.map { |k, v| [I18n.t("activerecord.attributes.trend.unit_phenomenon.#{k}"), v] }),
              { include_blank: "選択してください" },
              class: "mt-2 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </fieldset>
        <fieldset data-trend-submission-target-target="personPhenomenon" class="hidden">
          <legend class="block text-sm font-bold text-slate-700 dark:text-slate-200">個人の動向種別</legend>
          <span class="text-red-500 text-xs align-top">必須</span>
          <%= form.select :phenomenon,
              options_for_select(Trend.person_phenomenons.map { |k, v| [I18n.t("activerecord.attributes.trend.person_phenomenon.#{k}"), v] }),
              { include_blank: "選択してください" },
              class: "mt-2 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        </fieldset>
      <% end %>

      <div>
        <%= form.label :title, "タイトル", class: "block text-sm font-bold text-slate-700 dark:text-slate-200" %>
        <%= form.text_field :title,
            class: "mt-1 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :content, "本文", class: "block text-sm font-bold text-slate-700 dark:text-slate-200" %>
        <%= form.text_area :content, rows: 5, placeholder: "主対象以外の関連ユニット・メンバーへの言及があればこちらにご記入ください",
            class: "mt-1 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
      </div>

      <div>
        <%= form.label :via_url, "出典URL", class: "block text-sm font-bold text-slate-700 dark:text-slate-200" %>
        <span class="text-red-500 text-xs align-top">必須</span>
        <%= form.url_field :via_url, required: true, placeholder: "https://...",
            class: "mt-1 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">公式サイト・SNSなど、内容を確認できるURLを入力してください。</p>
      </div>

      <div>
        <%= form.label :email, "メールアドレス（任意）", class: "block text-sm font-bold text-slate-700 dark:text-slate-200" %>
        <%= form.email_field :email, placeholder: "内容確認のためご連絡する場合があります",
            class: "mt-1 block w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 px-3 py-2 text-sm text-slate-800 dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
        <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">返信を目的とするものではなく、内容確認のご連絡用です。</p>
      </div>

      <div class="flex items-start gap-2">
        <%= form.check_box :is_related_person, class: "mt-1 rounded border-slate-300 text-indigo-600 focus:ring-2 focus:ring-indigo-500" %>
        <%= form.label :is_related_person, "本人・関係者からの投稿です", class: "text-sm text-slate-700 dark:text-slate-200" %>
      </div>

      <div class="flex justify-center pt-2">
        <%= form.submit "投稿する", class: "px-8 py-3 bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-bold rounded-xl transition-colors shadow-sm hover:shadow-md cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
      </div>
    <% end %>
  </div>
</div>
