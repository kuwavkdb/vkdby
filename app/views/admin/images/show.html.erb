<div class="container mx-auto px-4 py-8 max-w-4xl">
  <div class="flex items-center gap-4 mb-6">
    <%= link_to admin_images_path, class: "text-sm text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 flex items-center gap-1" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
      </svg>
      画像一覧に戻る
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <%# 画像プレビュー %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 flex items-center justify-center" style="min-height: 300px;">
      <%= image_tag @image_url,
            alt: @attachment.blob.filename.to_s,
            class: "max-w-full max-h-96 object-contain rounded" %>
    </div>

    <%# メタ情報 %>
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-4 space-y-4">
      <h1 class="text-lg font-bold text-gray-900 dark:text-white break-all"><%= @attachment.blob.filename %></h1>

      <dl class="space-y-2 text-sm">
        <div>
          <dt class="text-gray-500 dark:text-gray-400">ファイルサイズ</dt>
          <dd class="text-gray-900 dark:text-white"><%= number_to_human_size(@attachment.blob.byte_size) %></dd>
        </div>
        <div>
          <dt class="text-gray-500 dark:text-gray-400">種別</dt>
          <dd class="text-gray-900 dark:text-white"><%= @attachment.blob.content_type %></dd>
        </div>
        <div>
          <dt class="text-gray-500 dark:text-gray-400">アップロード日時</dt>
          <dd class="text-gray-900 dark:text-white"><%= @attachment.created_at.strftime('%Y/%m/%d %H:%M') %></dd>
        </div>
      </dl>

      <%# URL コピー %>
      <div>
        <p class="text-sm text-gray-500 dark:text-gray-400 mb-1">URL</p>
        <div class="flex items-center gap-2">
          <input type="text"
                 value="<%= @image_url %>"
                 readonly
                 class="flex-1 text-xs font-mono rounded border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 text-gray-800 dark:text-gray-200 px-2 py-1 truncate"
                 aria-label="画像URL">
          <button type="button"
                  onclick="navigator.clipboard.writeText(this.previousElementSibling.value).then(() => { this.textContent = 'コピー済み'; setTimeout(() => this.textContent = 'コピー', 2000) })"
                  class="text-xs px-2 py-1 border border-gray-300 dark:border-gray-600 rounded text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-indigo-500"
                  aria-label="URLをクリップボードにコピー">
            コピー
          </button>
        </div>
      </div>

      <% if current_user.super_operator_or_above? %>
        <%= button_to "この画像を削除",
              admin_image_path(@attachment),
              method: :delete,
              form_class: "mt-2",
              onclick: "return confirm('この画像を削除しますか？Markdownから参照している場合は表示されなくなります。')",
              class: "w-full px-3 py-2 text-sm text-red-600 border border-red-300 rounded-md hover:bg-red-50 dark:text-red-400 dark:border-red-700 dark:hover:bg-red-900 cursor-pointer" %>
      <% end %>
    </div>
  </div>

  <%# 使われているページ %>
  <div class="mt-6 bg-white dark:bg-gray-800 rounded-lg shadow p-4">
    <h2 class="text-base font-semibold text-gray-900 dark:text-white mb-3">使われているページ</h2>

    <% record = @attachment.record %>
    <% all_records = [] %>
    <% all_records << { record: record, type: :attached } if record %>
    <% @referencing_sections.each do |s| %>
      <% all_records << { record: s, type: :referenced } unless record == s %>
    <% end %>
    <% @referencing_custom_pages.each do |p| %>
      <% all_records << { record: p, type: :referenced } unless record == p %>
    <% end %>

    <% if all_records.empty? %>
      <p class="text-sm text-gray-400 dark:text-gray-500">参照が見つかりませんでした。</p>
    <% else %>
      <ul class="divide-y divide-gray-100 dark:divide-gray-700">
        <% all_records.each do |entry| %>
          <% r = entry[:record] %>
          <% is_custom_page = r.is_a?(CustomPage) %>
          <% label = is_custom_page ? r.title : r.name %>
          <% edit_path = is_custom_page ? edit_admin_custom_page_path(r) : edit_admin_section_path(r) %>
          <li class="py-2 flex items-center gap-3 flex-wrap">
            <span class="inline-block px-1.5 py-0.5 rounded text-xs
              <%= is_custom_page ? 'bg-purple-100 text-purple-700 dark:bg-purple-900 dark:text-purple-300' : 'bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300' %>">
              <%= is_custom_page ? 'ページ' : 'セクション' %>
            </span>
            <% if entry[:type] == :attached %>
              <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-green-100 text-green-700 dark:bg-green-900 dark:text-green-300">添付先</span>
            <% else %>
              <span class="inline-block px-1.5 py-0.5 rounded text-xs bg-yellow-100 text-yellow-700 dark:bg-yellow-900 dark:text-yellow-300">本文に含む</span>
            <% end %>
            <span class="text-sm text-gray-900 dark:text-white">
              <% unless is_custom_page %>
                <% sectionable = r.sectionable %>
                <% if sectionable %>
                  <% sectionable_path = sectionable.is_a?(Unit) ? edit_admin_unit_path(sectionable) : edit_admin_person_path(sectionable) %>
                  <%= link_to sectionable.name, sectionable_path,
                        class: "text-gray-500 hover:text-indigo-600 dark:text-gray-400 dark:hover:text-indigo-400" %><span class="text-gray-400 dark:text-gray-500"> / </span>
                <% end %>
              <% end %>
              <%= link_to label, edit_path,
                    class: "text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-200" %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
