<%# ユニット・個人の編集画面に出す、未処理の情報の訂正の投稿（issue #1902）。内容を反映したら「対応済みにする」 %>
<% profile_corrections.each do |profile_correction| %>
  <div class="mb-4 px-4 py-3 rounded-md bg-indigo-50 border border-indigo-200 text-sm text-indigo-950 dark:bg-indigo-900/30 dark:border-indigo-800 dark:text-indigo-100" role="status">
    <p class="font-semibold">この<%= profile_correction.target_label %>への訂正の投稿があります。内容を反映したら「対応済みにする」を押してください。</p>
    <dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
      <dt class="text-gray-600 dark:text-gray-300">受付日時</dt>
      <dd><%= profile_correction.created_at.strftime('%Y-%m-%d %H:%M') %></dd>
      <dt class="text-gray-600 dark:text-gray-300">訂正内容</dt>
      <dd class="whitespace-pre-wrap break-words"><%= profile_correction.correction %></dd>
      <% if profile_correction.source_url.present? %>
        <dt class="text-gray-600 dark:text-gray-300">情報源</dt>
        <dd><%= link_to profile_correction.source_url, profile_correction.source_url, target: "_blank", rel: "noopener", class: "text-indigo-700 dark:text-indigo-300 underline break-all" %></dd>
      <% end %>
      <% if profile_correction.note.present? %>
        <dt class="text-gray-600 dark:text-gray-300">補足</dt>
        <dd class="whitespace-pre-wrap break-words"><%= profile_correction.note %></dd>
      <% end %>
      <% if profile_correction.email.present? %>
        <dt class="text-gray-600 dark:text-gray-300">連絡先</dt>
        <dd><%= profile_correction.email %></dd>
      <% end %>
    </dl>
    <div class="mt-3 flex flex-wrap gap-2">
      <%= button_to "対応済みにする", resolve_admin_profile_correction_path(profile_correction), method: :patch,
            form_class: "inline",
            class: "px-3 py-1.5 text-xs font-medium bg-indigo-600 text-white rounded hover:bg-indigo-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500" %>
      <%= button_to "却下", reject_admin_profile_correction_path(profile_correction), method: :patch,
            form_class: "inline",
            onclick: "return confirm('この投稿を却下しますか？')",
            class: "px-3 py-1.5 text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
    </div>
  </div>
<% end %>
