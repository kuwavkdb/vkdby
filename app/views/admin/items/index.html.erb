<% title = "アイテム管理" %>
<% content_for :title, title %>
<div class="container mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-4">
    <h1 class="text-2xl font-bold"><%= title %></h1>
    <% if current_user.super_operator_or_above? %>
      <%= link_to "新規追加", new_admin_item_path, class: "px-4 py-2 bg-indigo-600 text-white rounded-md hover:bg-indigo-700" %>
    <% end %>
  </div>

  <%= form_with url: admin_items_path, method: :get, local: true, class: "bg-white dark:bg-gray-800 shadow-sm rounded-lg p-4 mb-6 space-y-4" do |f| %>
    <%= f.hidden_field :discarded, value: params[:discarded] %>
    <div class="flex flex-wrap items-end gap-2">
      <div>
        <%= label_tag :q, "タイトル / ASIN / アーティスト名で検索", class: "block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1" %>
        <%= text_field_tag :q, params[:q], placeholder: "タイトル・ASIN・アーティスト名（部分一致）", class: "rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-base w-96 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>
    </div>

    <div class="flex flex-wrap items-end gap-2 pt-3 border-t border-gray-200 dark:border-gray-700">
      <div>
        <%= label_tag :match_type, "アーティストで絞り込む（対象）", class: "block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1" %>
        <%= select_tag :match_type,
              options_for_select([["指定しない", ""], %w[old_key old_key], %w[key key], %w[name name], %w[alias alias]], @match_type),
              class: "rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>
      <div>
        <%= label_tag :match_value, "検索値", class: "block text-xs font-medium text-gray-600 dark:text-gray-400 mb-1" %>
        <%= text_field_tag :match_value, @match_value, placeholder: "例: mucc", class: "rounded-md border-gray-300 shadow-sm focus:ring-indigo-500 focus:border-indigo-500 text-base w-64 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
      </div>
      <%= submit_tag "検索", class: "px-4 py-2 bg-white text-gray-700 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer dark:bg-gray-700 dark:text-gray-200 dark:border-gray-600" %>
    </div>
    <p class="text-xs text-gray-500 dark:text-gray-400">
      Item に紐づいているアーティストの old_key / key / name / alias（表示名）との完全一致で絞り込みます。一致した Item にはチェックボックスが表示され、まとめて別の Unit/Person に差し替えられます。
    </p>
  <% end %>

  <% if @match_type.present? && @match_value.present? %>
    <div class="mb-4 px-4 py-2 bg-amber-50 border border-amber-200 rounded-md text-sm text-amber-800 flex items-center justify-between">
      <span>アーティスト検索: <strong><%= @match_type %></strong> = 「<strong><%= @match_value %></strong>」に一致する Item のみ表示中</span>
      <%= link_to "解除", admin_items_path(q: params[:q]), class: "underline hover:no-underline" %>
    </div>
  <% end %>

  <div class="flex space-x-2 mb-4">
    <%= link_to "通常", admin_items_path(q: params[:q]),
        class: "px-3 py-1 rounded text-sm #{@show_discarded.blank? ? 'bg-indigo-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <%= link_to "削除済みのみ", admin_items_path(q: params[:q], discarded: "only"),
        class: "px-3 py-1 rounded text-sm #{@show_discarded == 'only' ? 'bg-red-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
    <%= link_to "全件", admin_items_path(q: params[:q], discarded: "all"),
        class: "px-3 py-1 rounded text-sm #{@show_discarded == 'all' ? 'bg-gray-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" %>
  </div>

  <div class="mb-4">
    <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
  </div>

  <% if @show_bulk_artist_ui %>
    <div class="mb-2">
      <button type="button" onclick="selectUnlinkedArtistsOnly()"
              title="Unit/Personに未紐付けの項目だけを選択します"
              class="text-sm text-indigo-600 hover:underline">未紐付けのみ選択</button>
    </div>
  <% end %>

  <%= render "items_table" %>

  <% if @show_bulk_artist_ui %>
    <%# 行内の「論理削除」ボタン(button_to)が独自の<form>を生成するため、テーブルをこの
        <form>の外に置き、チェックボックス側から form="#{Admin::ItemsHelper::BULK_ARTIST_UPDATE_FORM_ID}"
        属性で論理的に紐付けている。<form>を入れ子にすると、ブラウザのHTMLパーサがフォーム構造を
        破壊し、送信時に別行の_method/authenticity_tokenが紛れ込んでCSRFエラーになる(issue #1403) %>
    <%= form_with url: bulk_artist_update_admin_items_path, method: :patch, local: true,
          id: Admin::ItemsHelper::BULK_ARTIST_UPDATE_FORM_ID,
          html: { onsubmit: "return confirmBulkArtistUpdate()" } do %>
      <%= hidden_field_tag :match_type, @match_type %>
      <%= hidden_field_tag :match_value, @match_value %>
      <%= render "artist_replacement_picker" %>

      <div class="flex justify-end">
        <%= submit_tag "選択した項目のアーティストを一括差し替え",
              class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 cursor-pointer" %>
      </div>
    <% end %>

    <script>
      function confirmBulkArtistUpdate() {
        var checked = document.querySelectorAll('.row-check:checked');
        if (checked.length === 0) {
          alert('項目が選択されていません');
          return false;
        }
        return confirm('選択した ' + checked.length + ' 件のアーティストを一括で差し替えます。よろしいですか？');
      }

      function selectUnlinkedArtistsOnly() {
        document.querySelectorAll('.row-check').forEach(function(c) {
          c.checked = c.dataset.unlinked === 'true';
        });
        document.getElementById('check_all').checked = false;
      }
    </script>
  <% end %>

  <div class="mt-4">
    <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
  </div>
</div>
