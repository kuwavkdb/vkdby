<%= form_with(model: [:admin, item], class: "space-y-6", data: { controller: "item-form" }) do |form| %>
  <% if item.errors.any? %>
    <div class="bg-red-50 p-4 rounded text-red-700">
      <h2><%= pluralize(item.errors.count, "error") %> prohibited this item from being saved:</h2>
      <ul class="list-disc list-inside">
        <% item.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "タイトル", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%= form.text_field :title, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
  </div>

  <div class="flex flex-wrap items-end gap-6">
    <div data-controller="date-picker">
      <%= form.label :release_date, "発売日", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
      <div class="flex gap-2">
        <%= form.text_field :release_date, value: item.release_date&.strftime('%Y/%m/%d'), class: "mt-1 block w-32 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white", data: { date_picker_target: "input", action: "input->date-picker#syncPickerFromInput" } %>
        <button type="button" data-action="click->date-picker#open" aria-label="カレンダーから日付を選択" title="カレンダーから日付を選択" class="mt-1 flex w-11 shrink-0 items-center justify-center rounded-md border border-gray-300 shadow-sm hover:bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500 dark:text-gray-300" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
          </svg>
        </button>
        <input type="date" class="sr-only" tabindex="-1" aria-hidden="true" data-date-picker-target="picker" data-action="input->date-picker#apply">
      </div>
    </div>
    <div>
      <%= form.label :asin, "ASIN", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
      <%= form.text_field :asin, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white",
                                    data: { item_form_target: "asin" } %>
    </div>
  </div>

  <div>
    <%= form.label :link_url, "リンクURL", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%= form.url_field :link_url, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white",
                                  data: { item_form_target: "linkUrl", action: "focus->item-form#autofillLinkUrl" } %>
  </div>

  <div>
    <%= form.label :image_url, "画像URL", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%= form.url_field :image_url, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
  </div>

  <div class="flex items-center gap-2">
    <%= form.check_box :various_artists, class: "rounded border-gray-300 text-indigo-600 focus:ring-indigo-500 dark:border-gray-600 dark:bg-gray-700" %>
    <%= form.label :various_artists, "Various Artists（オムニバス）", class: "text-sm font-medium text-gray-900 dark:text-gray-100" %>
  </div>

  <div data-controller="artist-rows"
       data-artist-rows-url-units-value="<%= search_admin_units_path %>"
       data-artist-rows-url-people-value="<%= search_admin_people_path %>">
    <label class="block text-sm font-semibold text-gray-900 dark:text-gray-100 mb-1">アーティスト</label>

    <%# Row container %>
    <div data-artist-rows-target="container" class="space-y-2">
      <% (item.artists || []).each do |artist| %>
        <% search_mode = artist['confirmed'] == false || artist['name'].blank? %>
        <div class="flex items-center gap-2" data-artist-rows-target="row" data-mode="unit">
          <span class="drag-handle flex-none px-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 cursor-grab" aria-hidden="true">⠿</span>
          <button type="button"
                  class="flex-none px-2 py-1 text-xs rounded border border-indigo-300 bg-indigo-50 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300 dark:border-indigo-700 whitespace-nowrap"
                  data-action="click->artist-rows#toggleMode">Units</button>

          <div class="artist-search-wrapper flex-1 relative <%= 'hidden' unless search_mode %>">
            <input type="text"
                   class="artist-search-input block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                   placeholder="ユニット名で検索..."
                   autocomplete="off"
                   value="<%= search_mode ? artist['name'] : '' %>"
                   data-action="input->artist-rows#onSearchInput keydown->artist-rows#onKeydown focus->artist-rows#onSearchFocus">
            <div class="artist-results hidden absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 shadow-lg rounded-md border border-gray-200 dark:border-gray-700 max-h-60 overflow-auto"></div>
          </div>

          <%# Selected display (visible only when already selected) %>
          <div class="artist-selected-display flex-1 <%= search_mode ? 'items-center hidden' : 'flex items-center' %>">
            <span class="artist-chip inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
              <span class="artist-name-display">
                <% if artist['key'].present? %>
                  <a href="/<%= artist['key'] %>" target="_blank" class="hover:underline"><%= artist['name'] %></a>
                <% else %>
                  <%= artist['name'] %>
                <% end %>
              </span>
              <button type="button"
                      class="hover:text-red-600"
                      data-action="click->artist-rows#clearSelection">×</button>
            </span>
          </div>

          <%# Alias %>
          <input type="text"
                 class="artist-alias-input w-32 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                 placeholder="別名（任意）"
                 value="<%= artist['alias'] %>"
                 data-action="input->artist-rows#onAliasInput">

          <%# Hidden data %>
          <input type="hidden" class="artist-name-hidden" value="<%= search_mode ? '' : artist['name'] %>">
          <input type="hidden" class="artist-key-hidden" value="<%= artist['key'] %>">
          <input type="hidden" class="artist-old-key-hidden" value="<%= artist['old_key'] %>">

          <%# Remove row %>
          <button type="button"
                  class="flex-none text-gray-400 hover:text-red-500"
                  data-action="click->artist-rows#removeRow">×</button>
        </div>
      <% end %>
    </div>

    <%# Template for new empty rows %>
    <template data-artist-rows-target="template">
      <div class="flex items-center gap-2 mt-2" data-artist-rows-target="row" data-mode="unit">
        <span class="drag-handle flex-none px-1 text-gray-400 hover:text-gray-600 dark:hover:text-gray-300 cursor-grab" aria-hidden="true">⠿</span>
        <button type="button"
                class="flex-none px-2 py-1 text-xs rounded border border-indigo-300 bg-indigo-50 text-indigo-700 dark:bg-indigo-900 dark:text-indigo-300 dark:border-indigo-700 whitespace-nowrap"
                data-action="click->artist-rows#toggleMode">Units</button>

        <div class="artist-search-wrapper flex-1 relative">
          <input type="text"
                 class="artist-search-input block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
                 placeholder="ユニット名で検索..."
                 autocomplete="off"
                 data-action="input->artist-rows#onSearchInput keydown->artist-rows#onKeydown focus->artist-rows#onSearchFocus">
          <div class="artist-results hidden absolute z-10 mt-1 w-full bg-white dark:bg-gray-800 shadow-lg rounded-md border border-gray-200 dark:border-gray-700 max-h-60 overflow-auto"></div>
        </div>

        <div class="artist-selected-display flex-1 items-center hidden">
          <span class="artist-chip inline-flex items-center gap-1 px-3 py-1 rounded-full text-sm bg-indigo-100 text-indigo-800 dark:bg-indigo-900 dark:text-indigo-200">
            <span class="artist-name-display"></span>
            <button type="button"
                    class="hover:text-red-600"
                    data-action="click->artist-rows#clearSelection">×</button>
          </span>
        </div>

        <input type="text"
               class="artist-alias-input w-32 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-sm px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white"
               placeholder="別名（任意）"
               data-action="input->artist-rows#onAliasInput">

        <input type="hidden" class="artist-name-hidden" value="">
        <input type="hidden" class="artist-key-hidden" value="">
        <input type="hidden" class="artist-old-key-hidden" value="">

        <button type="button"
                class="flex-none text-gray-400 hover:text-red-500"
                data-action="click->artist-rows#removeRow">×</button>
      </div>
    </template>

    <button type="button"
            class="mt-2 text-sm text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-200"
            data-action="click->artist-rows#addRow">+ アーティストを追加</button>

    <%= hidden_field_tag "item[artists_json]", (item.artists || []).to_json,
        data: { artist_rows_target: "hiddenField" } %>
  </div>

  <div class="sticky bottom-0 z-10 -mx-6 -mb-6 flex justify-end gap-x-4 rounded-b-lg border-t border-gray-200 bg-white px-6 py-4 dark:border-gray-700 dark:bg-gray-800">
    <%= link_to "キャンセル", admin_items_path, class: "px-4 py-2 text-sm text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" %>
    <%= form.submit item.persisted? ? "更新" : "作成", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500" %>
  </div>
<% end %>
