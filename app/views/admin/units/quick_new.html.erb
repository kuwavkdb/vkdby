<% title = "Unit簡単登録" %>
<% content_for :title, title %>
<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <div class="flex items-center gap-3 mb-1">
      <h1 class="text-2xl font-bold"><%= title %></h1>
      <%= link_to "通常の登録画面", new_admin_unit_path,
          class: "text-sm text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-indigo-400 hover:underline" %>
    </div>
    <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
      バンド名とメンバー名をまとめて入力して、1回の登録でUnit・現在のラインナップ・メンバーを作成します。
      詳細な設定は保存後に編集画面から行えます。
    </p>

    <details class="bg-white dark:bg-gray-800 shadow rounded-lg p-6 mb-6" data-controller="quick-unit-yaml-paste">
      <summary class="text-sm font-semibold text-gray-900 dark:text-gray-100 cursor-pointer select-none">YAMLから一括入力（任意）</summary>
      <p class="text-xs text-gray-500 dark:text-gray-400 mt-2 mb-3">
        unit-url スキル等が出力したYAMLを貼り付けて「フォームに反映」を押すと、下のフォームの各欄に自動入力されます。
        URLのパラメーターと違って長さの制限を受けないため、メンバーが多い場合や誕生日等の補足情報もまとめて渡せます。
        あくまで入力の下書きで、反映後の内容は保存前に画面で確認・修正してください。
      </p>
      <textarea data-quick-unit-yaml-paste-target="textarea"
                rows="6"
                placeholder="name: バンド名&#10;key: band-key&#10;members:&#10;  - person_name: 名前&#10;    part: vocal"
                aria-label="貼り付け用YAML"
                class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white font-mono"></textarea>
      <div class="mt-2 flex items-center gap-3">
        <button type="button"
                data-action="click->quick-unit-yaml-paste#apply"
                class="px-3 py-1.5 text-sm font-medium rounded-md border border-indigo-300 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 dark:bg-indigo-900 dark:text-indigo-300 dark:border-indigo-700 dark:hover:bg-indigo-800 cursor-pointer focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500">
          フォームに反映
        </button>
        <p data-quick-unit-yaml-paste-target="error" class="text-xs text-red-600 dark:text-red-400 hidden" role="alert"></p>
        <p data-quick-unit-yaml-paste-target="success" class="text-xs text-green-600 dark:text-green-400 hidden" role="status"></p>
      </div>
    </details>

    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6" data-controller="quick-unit-form" data-quick-unit-form-part-options-value="<%= SnapshotPerson.parts.keys.to_json %>">
      <%= form_with model: @unit, url: quick_create_admin_units_path, class: "space-y-6" do |form| %>
        <% if @unit.errors.any? %>
          <div class="bg-red-50 dark:bg-red-900/50 p-4 rounded text-red-700 dark:text-red-100">
            <h2><%= pluralize(@unit.errors.count, "error") %> prohibited this unit from being saved:</h2>
            <ul class="list-disc list-inside">
              <% @unit.errors.each do |error| %>
                <li><%= error.full_message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :name, "バンド名", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
          <%= form.text_field :name, required: true, data: { "quick-unit-form-target": "name" }, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
        </div>

        <div>
          <%= form.label :key, "キー", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
          <%= form.text_field :key, required: true,
              "aria-describedby": @duplicated_unit ? "unit_key_duplicated_warning" : nil,
              data: { "quick-unit-form-target": "key" },
              class: "mt-1 block w-full rounded-md border shadow-sm px-2 py-2 text-base dark:bg-gray-700 dark:text-white #{@duplicated_unit ? 'border-red-400 focus:border-red-500 focus:ring-red-500 dark:border-red-500' : 'border-gray-300 focus:border-indigo-500 focus:ring-indigo-500 dark:border-gray-600'}" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400">プロフィールページのURL（/キー）に使われます。半角英数字推奨。</p>
          <% if @duplicated_unit %>
            <p id="unit_key_duplicated_warning" class="mt-1 text-xs font-semibold text-red-600 dark:text-red-400">
              このキーはすでに
              <%= link_to "「#{@duplicated_unit.name}」#{@duplicated_unit.discarded? ? '（削除済み）' : ''}",
                  edit_admin_unit_path(@duplicated_unit),
                  class: "underline hover:text-red-800 dark:hover:text-red-300", target: "_blank", rel: "noopener" %>
              で使われています（重複した状態のまま保存しようとするとエラーになります）。別のキーに変更してください。
            </p>
          <% end %>
        </div>

        <div>
          <%= form.label :unit_type, "ユニット種別", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
          <div class="mt-2 space-x-4" data-quick-unit-form-target="unitType">
            <% Unit.unit_types.keys.each do |type| %>
              <label class="inline-flex items-center">
                <%= form.radio_button :unit_type, type, checked: type == (@unit.unit_type || "band"), class: "form-radio text-indigo-600 focus:ring-indigo-500 border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>
                <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100"><%= type.humanize %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div>
          <%= form.label :status, "ステータス", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
          <div class="mt-2 flex flex-wrap gap-4" data-quick-unit-form-target="status">
            <% Unit.statuses.keys.each do |status| %>
              <label class="inline-flex items-center">
                <%= form.radio_button :status, status, checked: status == (@unit.status || "active"), class: "form-radio text-indigo-600 focus:ring-indigo-500 border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>
                <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100"><%= Unit::STATUS_TRANSLATIONS[status] %></span>
              </label>
            <% end %>
          </div>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">活動時期</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">結成日・活動開始日などが分かる場合に入力します（任意）。</p>
          <div class="space-y-4" data-quick-unit-form-target="activityPeriodContainer">
            <%
              periods_for_form = @unit.activity_periods
              periods_for_form << OpenStruct.new(from: "", to: "", label: "")
            %>
            <% periods_for_form.each_with_index do |period, index| %>
              <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-end" data-quick-unit-form-target="activityPeriodRow">
                <div class="flex-1 w-full">
                  <%= label_tag "unit_activity_periods_attributes_#{index}_from", "開始", class: "block text-xs font-semibold text-gray-900 dark:text-gray-100" %>
                  <%= text_field_tag "unit[activity_periods_attributes][#{index}][from]", period.from, id: "unit_activity_periods_attributes_#{index}_from", placeholder: "例: 2010.01", class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                </div>
                <div class="flex-1 w-full">
                  <%= label_tag "unit_activity_periods_attributes_#{index}_to", "終了", class: "block text-xs font-semibold text-gray-900 dark:text-gray-100" %>
                  <%= text_field_tag "unit[activity_periods_attributes][#{index}][to]", period.to, id: "unit_activity_periods_attributes_#{index}_to", placeholder: "例: 2015.06（活動中なら空欄）", class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                </div>
                <div class="flex-1 w-full">
                  <%= label_tag "unit_activity_periods_attributes_#{index}_label", "ラベル", class: "block text-xs font-semibold text-gray-900 dark:text-gray-100" %>
                  <%= text_field_tag "unit[activity_periods_attributes][#{index}][label]", period.label, id: "unit_activity_periods_attributes_#{index}_label", placeholder: "例: 活動休止前", class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                </div>
              </div>
            <% end %>
          </div>
          <template data-quick-unit-form-target="activityPeriodTemplate">
            <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-end" data-quick-unit-form-target="activityPeriodRow">
              <div class="flex-1 w-full">
                <label class="block text-xs font-semibold text-gray-900 dark:text-gray-100">開始</label>
                <input type="text" name="unit[activity_periods_attributes][__INDEX__][from]" placeholder="例: 2010.01" class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
              </div>
              <div class="flex-1 w-full">
                <label class="block text-xs font-semibold text-gray-900 dark:text-gray-100">終了</label>
                <input type="text" name="unit[activity_periods_attributes][__INDEX__][to]" placeholder="例: 2015.06（活動中なら空欄）" class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
              </div>
              <div class="flex-1 w-full">
                <label class="block text-xs font-semibold text-gray-900 dark:text-gray-100">ラベル</label>
                <input type="text" name="unit[activity_periods_attributes][__INDEX__][label]" placeholder="例: 活動休止前" class="mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
              </div>
            </div>
          </template>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">※開始・終了ともに空の行は保存時に無視されます</p>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">公式リンク</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">公式サイト・SNS等のURLが分かる場合に入力します（任意）。</p>
          <div class="space-y-3" data-quick-unit-form-target="linkContainer">
            <%
              links_for_form = @unit.links
              links_for_form << Link.new
            %>
            <% links_for_form.each_with_index do |link, index| %>
              <div class="flex flex-col sm:flex-row gap-2 sm:items-center" data-quick-unit-form-target="linkRow">
                <%= text_field_tag "unit[links_attributes][#{index}][text]", link.text, placeholder: "タイトル", "aria-label": "リンクのタイトル", class: "block w-full sm:w-40 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                <%= text_field_tag "unit[links_attributes][#{index}][url]", link.url, placeholder: "URL（https://...）", "aria-label": "リンクのURL", class: "block w-full flex-1 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
              </div>
            <% end %>
          </div>
          <template data-quick-unit-form-target="linkTemplate">
            <div class="flex flex-col sm:flex-row gap-2 sm:items-center" data-quick-unit-form-target="linkRow">
              <input type="text" name="unit[links_attributes][__INDEX__][text]" placeholder="タイトル" aria-label="リンクのタイトル" class="block w-full sm:w-40 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
              <input type="text" name="unit[links_attributes][__INDEX__][url]" placeholder="URL（https://...）" aria-label="リンクのURL" class="block w-full flex-1 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
            </div>
          </template>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">※URLが空の行は保存時に無視されます</p>
        </div>

        <div class="border-t border-gray-200 dark:border-gray-700 pt-6">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">現在のラインナップ</h2>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-4">「現在のラインナップ」「有効」としてスナップショットを1件作成します。日付・ラベルは任意です。</p>

          <div class="grid grid-cols-2 gap-4 mb-4" data-controller="date-picker">
            <div>
              <%= label_tag "unit_snapshot_date", "日付（任意）", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
              <div class="flex gap-2">
                <%= text_field_tag "unit[snapshot_date]", @snapshot_date_prefill, data: { date_picker_target: "input", "quick-unit-form-target": "snapshotDate", action: "input->date-picker#syncPickerFromInput" }, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                <button type="button" data-action="click->date-picker#open" aria-label="カレンダーから日付を選択" title="カレンダーから日付を選択" class="mt-1 flex w-11 shrink-0 items-center justify-center rounded-md border border-gray-300 shadow-sm hover:bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600">
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500 dark:text-gray-300" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                  </svg>
                </button>
                <input type="date" class="sr-only" tabindex="-1" aria-hidden="true" data-date-picker-target="picker" data-action="input->date-picker#apply">
              </div>
            </div>
            <div>
              <%= label_tag "unit_snapshot_label", "ラベル（任意）", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
              <%= text_field_tag "unit[snapshot_label]", @snapshot_label_prefill, placeholder: "例: 結成時", data: { "quick-unit-form-target": "snapshotLabel" }, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
            </div>
          </div>

          <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-2">メンバー</h3>
          <div class="space-y-3" data-quick-unit-form-target="memberContainer">
            <% @member_rows.each_with_index do |member, index| %>
              <% extra_profile = member.respond_to?(:extra_profile) ? (member.extra_profile || {}) : {} %>
              <div class="rounded-md border border-gray-200 dark:border-gray-700 p-3" data-quick-unit-form-target="memberRow">
                <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
                  <%= text_field_tag "unit[members][#{index}][person_name]", member.person_name, placeholder: "メンバー名", "aria-label": "メンバー#{index + 1}の名前", class: "block w-full flex-1 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                  <%= select_tag "unit[members][#{index}][part]", options_for_select(SnapshotPerson.parts.keys.map { |k| [k.humanize, k] }, member.part), "aria-label": "メンバー#{index + 1}のパート", class: "block w-full sm:w-40 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                </div>
                <details class="mt-2">
                  <summary class="text-xs text-gray-500 dark:text-gray-400 cursor-pointer select-none">補足プロフィール（誕生日・出身地等。任意）</summary>
                  <div class="mt-2 grid grid-cols-2 gap-2">
                    <%= text_field_tag "unit[members][#{index}][extra_profile][birthday]", extra_profile["birthday"], placeholder: "誕生日 例: 7/12", "aria-label": "メンバー#{index + 1}の誕生日", class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                    <%= number_field_tag "unit[members][#{index}][extra_profile][birth_year]", extra_profile["birth_year"], placeholder: "生年 例: 1990", "aria-label": "メンバー#{index + 1}の生年", class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                    <%= text_field_tag "unit[members][#{index}][extra_profile][blood]", extra_profile["blood"], placeholder: "血液型 例: AB", "aria-label": "メンバー#{index + 1}の血液型", class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                    <%= text_field_tag "unit[members][#{index}][extra_profile][hometown]", extra_profile["hometown"], placeholder: "出身地 例: 東京都", "aria-label": "メンバー#{index + 1}の出身地", class: "block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
                  </div>
                </details>
              </div>
            <% end %>
          </div>
          <template data-quick-unit-form-target="memberTemplate">
            <div class="rounded-md border border-gray-200 dark:border-gray-700 p-3" data-quick-unit-form-target="memberRow">
              <div class="flex flex-col sm:flex-row gap-2 sm:items-center">
                <input type="text" name="unit[members][__INDEX__][person_name]" placeholder="メンバー名" aria-label="メンバー名" class="block w-full flex-1 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                <select name="unit[members][__INDEX__][part]" aria-label="メンバーのパート" class="block w-full sm:w-40 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1.5 sm:text-sm dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                  <% SnapshotPerson.parts.keys.each do |part| %>
                    <option value="<%= part %>"><%= part.humanize %></option>
                  <% end %>
                </select>
              </div>
              <details class="mt-2">
                <summary class="text-xs text-gray-500 dark:text-gray-400 cursor-pointer select-none">補足プロフィール（誕生日・出身地等。任意）</summary>
                <div class="mt-2 grid grid-cols-2 gap-2">
                  <input type="text" name="unit[members][__INDEX__][extra_profile][birthday]" placeholder="誕生日 例: 7/12" aria-label="メンバーの誕生日" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                  <input type="number" name="unit[members][__INDEX__][extra_profile][birth_year]" placeholder="生年 例: 1990" aria-label="メンバーの生年" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                  <input type="text" name="unit[members][__INDEX__][extra_profile][blood]" placeholder="血液型 例: AB" aria-label="メンバーの血液型" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                  <input type="text" name="unit[members][__INDEX__][extra_profile][hometown]" placeholder="出身地 例: 東京都" aria-label="メンバーの出身地" class="block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-1 text-xs dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                </div>
              </details>
            </div>
          </template>
          <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">※名前が空欄の行は無視されます。Personとの紐付けやSNS・経歴などの詳細は保存後に編集画面から設定できます。</p>
        </div>

        <div class="flex justify-end gap-x-4">
          <%= link_to "キャンセル", admin_units_path, class: "px-4 py-2 text-sm text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" %>
          <%= form.submit "作成", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </div>
