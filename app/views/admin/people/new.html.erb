<% title = "Person新規作成" %>
<% content_for :title, title %>
<%# フォームは広い画面で2段組み（lg:columns-2）になるため、編集画面と同じ幅にする。
    max-w-2xl だと1段が約300pxしかなく、誕生日の入力欄などが列からはみ出していた（issue #2060）
    パートの選択肢をタイルにして横に広がったため、max-w-7xl より少し広げている（issue #2144） %>
<div class="mx-auto px-2 py-4">
  <div class="max-w-[88rem] mx-auto">
    <h1 class="text-2xl font-bold mb-6 dark:text-white"><%= title %></h1>
    <div class="bg-white shadow rounded-lg p-6 dark:bg-gray-800">
      <%= render "form", person: @person %>
    </div>
  </div>
</div>
