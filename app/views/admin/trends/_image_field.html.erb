<%# 動向の画像1枚分の入力欄（issue #2014）。name は添付名（:image / :bottom_image）、代替テキストは "#{name}_alt" 列 %>
<% alt_attribute = :"#{name}_alt" %>
<% attachment = trend.public_send(name) %>
<div class="space-y-4">
  <div>
    <%= form.label name, label, class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%# 保存に失敗して描き直したときは、まだ保存していない画像のプレビューは出さない %>
    <% if attachment.attached? && !trend.attachment_changes.key?(name.to_s) %>
      <div class="mt-2 flex flex-wrap items-end gap-4">
        <%= image_tag rails_blob_path(attachment, disposition: :inline), alt: trend.public_send(:"#{alt_attribute}_text"), class: "h-32 w-auto rounded-md border border-gray-200 object-contain dark:border-gray-700" %>
        <label class="inline-flex items-center">
          <%= form.check_box :"remove_#{name}", class: "form-checkbox text-indigo-600 focus:ring-indigo-500 border-gray-300 dark:bg-gray-700 dark:border-gray-600" %>
          <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100">画像を削除する</span>
        </label>
      </div>
    <% end %>
    <%= form.file_field name, accept: "image/*", aria: { describedby: "trend_#{name}_hint" },
          class: "mt-2 block w-full text-sm text-gray-900 dark:text-gray-100 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-3 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100 dark:file:bg-gray-700 dark:file:text-gray-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
    <p id="trend_<%= name %>_hint" class="mt-1 text-xs text-gray-500 dark:text-gray-400"><%= hint %>。選び直すと差し替える</p>
  </div>
  <div>
    <%= form.label alt_attribute, "#{label}の代替テキスト（任意）", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%= form.text_field alt_attribute, aria: { describedby: "trend_#{alt_attribute}_hint" },
          class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base px-2 py-2 dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
    <p id="trend_<%= alt_attribute %>_hint" class="mt-1 text-xs text-gray-500 dark:text-gray-400">画像の内容を短く書く。空ならタイトルを使う</p>
  </div>
</div>
