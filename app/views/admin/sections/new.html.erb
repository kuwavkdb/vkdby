<% title = "セクション追加" %>
<% content_for :title, title %>
<div class="container mx-auto px-2 py-4 max-w-4xl">
  <div class="sticky top-0 z-30 -mx-2 px-2 py-4 mb-6 flex justify-between items-center bg-zinc-50/95 dark:bg-zinc-950/95 backdrop-blur-sm border-b border-zinc-200 dark:border-zinc-800">
    <h1 class="text-2xl font-bold dark:text-white"><%= title %></h1>
    <%= link_to sectionable_label(@sectionable), sectionable_path(@sectionable),
          class: "text-sm font-medium text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300" %>
  </div>
  <%= render "form", section: @section, sectionable: @sectionable %>

  <%= render "admin/shared/markdown_help" %>
</div>
