<%= form_with(model: [:admin, unit, unit_snapshot], class: "space-y-6") do |form| %>
  <% if unit_snapshot.errors.any? %>
    <div class="bg-red-50 p-4 rounded text-red-700">
      <h2><%= unit_snapshot.errors.count %>件のエラーがあります：</h2>
      <ul class="list-disc list-inside">
        <% unit_snapshot.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div data-controller="date-picker">
    <%= form.label :snapshot_date, "日付", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <div class="flex gap-2">
      <%= form.text_field :snapshot_date, value: unit_snapshot.snapshot_date&.strftime('%Y/%m/%d'), class: "mt-1 block w-32 rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white", data: { date_picker_target: "input", action: "input->date-picker#syncPickerFromInput" } %>
      <button type="button" data-action="click->date-picker#open" aria-label="カレンダーから日付を選択" title="カレンダーから日付を選択" class="mt-1 flex w-11 shrink-0 items-center justify-center rounded-md border border-gray-300 shadow-sm hover:bg-gray-50 focus:border-indigo-500 focus:ring-indigo-500 dark:bg-gray-700 dark:border-gray-600 dark:hover:bg-gray-600">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-gray-500 dark:text-gray-300" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
        </svg>
      </button>
      <input type="date" class="sr-only" tabindex="-1" aria-hidden="true" data-date-picker-target="picker" data-action="input->date-picker#apply">
    </div>
  </div>

  <div>
    <%= form.label :label, "ラベル", class: "block text-sm font-semibold text-gray-900 dark:text-gray-100" %>
    <%= form.text_field :label, class: "mt-1 block w-full rounded-md border border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 px-2 py-2 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white", placeholder: "例: 結成時, 5周年" %>
    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">任意のラベルを設定できます。</p>
  </div>

  <div>
    <label class="inline-flex items-center">
      <%= form.check_box :current, class: "form-checkbox text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600" %>
      <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100">現在のラインナップ</span>
    </label>
  </div>

  <div>
    <label class="inline-flex items-center">
      <%= form.check_box :active, class: "form-checkbox text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600" %>
      <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100">有効（ユニットページに表示する）</span>
    </label>
  </div>

  <div>
    <label class="inline-flex items-center">
      <%= form.check_box :past, class: "form-checkbox text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded dark:bg-gray-700 dark:border-gray-600" %>
      <span class="ml-2 text-sm font-medium text-gray-900 dark:text-gray-100">関連（過去）</span>
    </label>
  </div>

  <div class="flex justify-end gap-x-4">
    <%= link_to "キャンセル", admin_unit_unit_snapshots_path(unit), class: "px-4 py-2 text-sm text-gray-700 hover:text-gray-900 dark:text-gray-300 dark:hover:text-white" %>
    <%= form.submit unit_snapshot.persisted? ? "更新" : "作成", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
  </div>
<% end %>
