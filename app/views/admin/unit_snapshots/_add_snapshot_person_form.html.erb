<div class="bg-white shadow rounded-lg">
  <details class="group">
    <summary class="flex justify-between items-center font-medium cursor-pointer list-none p-6">
      <h3 class="text-lg font-medium leading-6 text-gray-900 dark:text-gray-100">Add Member</h3>
      <span class="transition group-open:rotate-180">
        <svg fill="none" height="24" shape-rendering="geometricPrecision" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24" width="24"><path d="M6 9l6 6 6-6"></path></svg>
      </span>
    </summary>
    <div class="text-neutral-600 px-6 pb-6 group-open:animate-fadeIn">
      <%= form_with(model: [:admin, unit, unit_snapshot, snapshot_person], class: "space-y-4") do |form| %>
        <div data-controller="autocomplete" data-autocomplete-url-value="<%= search_admin_people_path %>">
          <%= form.label :person_id, "Person (search)", class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <input type="text" placeholder="Search by name..." class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" data-autocomplete-target="input" data-action="input->autocomplete#search">
          <div data-autocomplete-target="results" class="absolute z-50 mt-1 bg-white dark:bg-gray-800 shadow-lg rounded-md border border-gray-200 dark:border-gray-700 hidden"></div>
          <%= form.hidden_field :person_id, data: { autocomplete_target: "hidden" } %>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Optional: Link to an existing person record.</p>
        </div>

        <div>
          <%= form.label :person_name, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= form.text_field :person_name, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white", placeholder: "Name (if not linked)" %>
          <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Used when person is not linked above.</p>
        </div>

        <div>
          <%= form.label :part, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= form.text_field :part, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white", placeholder: "e.g. Vo., Gt., Ba., Dr." %>
        </div>

        <div>
          <%= form.label :sort_order, class: "block text-sm font-medium text-gray-700 dark:text-gray-300" %>
          <%= form.number_field :sort_order, value: snapshot_person.sort_order || 0, class: "mt-1 block w-24 rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 text-base dark:bg-gray-700 dark:border-gray-600 dark:text-white" %>
        </div>

        <div class="flex justify-end">
          <%= form.submit "Add Member", class: "px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500 cursor-pointer" %>
        </div>
      <% end %>
    </div>
  </details>
</div>
