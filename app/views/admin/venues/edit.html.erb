<% title = "会場の編集: #{@venue.name}" %>
<% content_for :title, title %>
<div class="container mx-auto px-4 py-8">
  <div class="max-w-2xl mx-auto">
    <%# 公開ページへの導線（issue #1787）。ユニット・個人の編集画面と同じくタイトルの右側に置く %>
    <div class="mb-6 flex flex-wrap justify-between items-center gap-x-4 gap-y-2">
      <h1 class="text-2xl font-bold"><%= title %></h1>
      <% if @public_venue %>
        <%= link_to (@public_venue == @venue ? "公開ページを見る" : "転送先の公開ページを見る"), venue_path(@public_venue.key),
              class: "text-indigo-600 hover:text-indigo-900 dark:text-indigo-400 dark:hover:text-indigo-300 rounded focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
      <% end %>
    </div>
    <% if @venue.discarded? %>
      <p class="mb-4 px-4 py-2 rounded-md bg-red-50 text-red-700 text-sm dark:bg-red-900/40 dark:text-red-200">この会場は論理削除されています。</p>
    <% end %>
    <% if @venue.destination_key.present? %>
      <p class="mb-4 px-4 py-2 rounded-md bg-amber-50 text-amber-800 text-sm dark:bg-amber-900/40 dark:text-amber-200">
        この会場は <code class="font-mono"><%= @venue.destination_key %></code> へ転送されます。
      </p>
    <% end %>
    <% if @venue_corrections.present? %>
      <%# 未処理の訂正の投稿（issue #1814）。内容を反映したら「対応済みにする」 %>
      <% @venue_corrections.each do |venue_submission| %>
        <% actions = capture do %>
          <div class="mt-3 flex flex-wrap gap-2">
            <%= button_to "対応済みにする", resolve_admin_venue_submission_path(venue_submission), method: :patch,
                  form_class: "inline",
                  class: "px-3 py-1.5 text-xs font-medium bg-indigo-600 text-white rounded hover:bg-indigo-700 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-indigo-500" %>
            <%= button_to "却下", reject_admin_venue_submission_path(venue_submission), method: :patch,
                  form_class: "inline",
                  onclick: "return confirm('この投稿を却下しますか？')",
                  class: "px-3 py-1.5 text-xs font-medium bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded hover:bg-gray-300 dark:hover:bg-gray-600 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500" %>
          </div>
        <% end %>
        <%= render "admin/venue_submissions/summary", venue_submission: venue_submission, actions: actions,
              heading: "この会場への訂正の投稿があります。内容を反映したら「対応済みにする」を押してください。" %>
      <% end %>
    <% end %>
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg p-6">
      <%= render "form", venue: @venue %>
    </div>
    <%= render "admin/shared/change_key_form", change_key_path: change_key_admin_venue_path(@venue), form_id: "change_key_form" %>

    <% if current_user.super_operator_or_above? && !@venue.discarded? %>
      <div class="mt-4 flex justify-end">
        <%= button_to "論理削除", admin_venue_path(@venue), method: :delete,
            form_class: "inline",
            onclick: "return confirm('#{j @venue.name} を論理削除しますか？')",
            class: "px-3 py-1.5 text-sm text-white bg-red-600 hover:bg-red-700 rounded cursor-pointer border-0 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500" %>
      </div>
    <% end %>

    <div class="mt-6">
      <%= render "admin/wiki_page_imports/import_target_panel", wiki_page_imports: @wiki_page_imports, import_target: @venue %>
    </div>

    <%= render "admin/shared/update_logs", update_logs: @update_logs %>
  </div>
</div>
