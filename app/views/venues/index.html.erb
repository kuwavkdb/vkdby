<% content_for :title, ["会場一覧", @prefecture, (@area if @prefecture), (Venue::VENUE_TYPE_TRANSLATIONS[@venue_type] if @venue_type)].compact.join(' ') %>
<%
  chip_base = "inline-block px-3 py-1.5 rounded-full text-sm font-bold transition-colors whitespace-nowrap border focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-900"
  chip_active = "bg-indigo-600 text-white border-indigo-600 dark:bg-amber-400 dark:text-zinc-900 dark:border-amber-400"
  chip_inactive = "bg-white text-zinc-600 border-zinc-300 hover:bg-zinc-50 hover:text-indigo-700 dark:bg-zinc-800 dark:text-zinc-300 dark:border-zinc-600 dark:hover:bg-zinc-700 dark:hover:text-amber-400"
  filter_params = { q: @q, prefecture: @prefecture, area: @area, venue_type: @venue_type }
%>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <div class="p-5 md:p-8 relative">
      <%# ヘッダーはユニット・個人の一覧（UNITS / PEOPLE）と揃える。色はProfileHeaderComponentの会場の色（teal）に合わせる %>
      <header class="mb-8 text-center flex flex-col items-center">
        <h1 class="text-3xl font-black text-zinc-800 dark:text-zinc-100 flex items-center justify-center gap-3">
          <span class="text-teal-700 dark:text-teal-400">VENUES</span>
          <span class="text-zinc-500 dark:text-zinc-400 text-lg font-bold"><%= @pagy.count %> records</span>
        </h1>
      </header>

      <div class="mb-6">
        <%= form_with url: venues_path, method: :get, local: true, class: "flex gap-2", role: "search" do |f| %>
          <%= hidden_field_tag :prefecture, @prefecture if @prefecture %>
          <%= hidden_field_tag :area, @area if @prefecture && @area %>
          <%= hidden_field_tag :venue_type, @venue_type if @venue_type %>
          <%= f.label :q, "会場名で検索", class: "sr-only" %>
          <%= f.search_field :q, value: @q, placeholder: "Search venues...",
                class: "w-full bg-zinc-50 dark:bg-zinc-800 border border-zinc-200 dark:border-zinc-700 rounded-xl px-4 py-3 text-zinc-800 dark:text-zinc-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 dark:focus:ring-amber-400 transition-all placeholder:text-zinc-500" %>
          <%= f.button type: "submit", aria: { label: "検索" }, class: "bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-xl transition-colors shadow-sm hover:shadow-md flex items-center justify-center min-w-[3rem] focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-900" do %>
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
          <% end %>
        <% end %>
      </div>

      <div class="space-y-4 mb-8">
        <nav aria-label="都道府県で絞り込み">
          <h2 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5">都道府県</h2>
          <ul class="flex flex-wrap gap-1.5">
            <li>
              <%= link_to "すべて", venues_path(filter_params.merge(prefecture: nil, area: nil).compact),
                    class: "#{chip_base} #{@prefecture ? chip_inactive : chip_active}",
                    aria: { current: (@prefecture ? nil : "page") } %>
            </li>
            <% @prefecture_counts.each do |prefecture, count| %>
              <li>
                <%= link_to venues_path(filter_params.merge(prefecture: prefecture, area: nil).compact),
                      class: "#{chip_base} #{@prefecture == prefecture ? chip_active : chip_inactive}",
                      aria: { current: (@prefecture == prefecture ? "page" : nil) } do %>
                  <%= prefecture %><span class="ml-1 text-xs font-normal opacity-80">(<%= count %>)</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>

        <% if @area_counts.present? %>
          <nav aria-label="エリアで絞り込み">
            <h2 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5">エリア（<%= @prefecture %>）</h2>
            <ul class="flex flex-wrap gap-1.5">
              <li>
                <%= link_to "すべて", venues_path(filter_params.merge(area: nil).compact),
                      class: "#{chip_base} #{@area ? chip_inactive : chip_active}",
                      aria: { current: (@area ? nil : "page") } %>
              </li>
              <% @area_counts.each do |area, count| %>
                <li>
                  <%= link_to venues_path(filter_params.merge(area: area).compact),
                        class: "#{chip_base} #{@area == area ? chip_active : chip_inactive}",
                        aria: { current: (@area == area ? "page" : nil) } do %>
                    <%= area %><span class="ml-1 text-xs font-normal opacity-80">(<%= count %>)</span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </nav>
        <% end %>

        <nav aria-label="種別で絞り込み">
          <h2 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5">種別</h2>
          <ul class="flex flex-wrap gap-1.5">
            <li>
              <%= link_to "すべて", venues_path(filter_params.merge(venue_type: nil).compact),
                    class: "#{chip_base} #{@venue_type ? chip_inactive : chip_active}",
                    aria: { current: (@venue_type ? nil : "page") } %>
            </li>
            <% Venue::VENUE_TYPE_TRANSLATIONS.each do |type, label| %>
              <% next unless @venue_type_counts[type] %>
              <li>
                <%= link_to venues_path(filter_params.merge(venue_type: type).compact),
                      class: "#{chip_base} #{@venue_type == type ? chip_active : chip_inactive}",
                      aria: { current: (@venue_type == type ? "page" : nil) } do %>
                  <%= label %><span class="ml-1 text-xs font-normal opacity-80">(<%= @venue_type_counts[type] %>)</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      </div>

      <% if @venues.any? %>
        <%# 一覧はテーブル形式（issue #1783）。スマホでは横スクロールさせる %>
        <div class="overflow-x-auto -mx-5 md:mx-0">
          <table class="w-full min-w-[40rem] text-sm">
            <caption class="sr-only">会場一覧</caption>
            <thead>
              <tr class="border-b-2 border-zinc-200 dark:border-zinc-700 text-left text-xs font-semibold text-zinc-500 dark:text-zinc-400">
                <th scope="col" class="py-2 pl-5 md:pl-2 pr-3">会場名</th>
                <th scope="col" class="py-2 px-3">種別</th>
                <th scope="col" class="py-2 px-3">都道府県</th>
                <th scope="col" class="py-2 px-3">エリア</th>
                <th scope="col" class="py-2 px-3 <%= 'pr-5 md:pr-2' unless @trend_counts %> text-right">キャパ</th>
                <%# 動向件数はログイン時のみ表示する %>
                <% if @trend_counts %>
                  <th scope="col" class="py-2 pl-3 pr-5 md:pr-2 text-right">動向</th>
                <% end %>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-200 dark:divide-zinc-700">
              <% @venues.each do |venue| %>
                <tr class="hover:bg-zinc-50 dark:hover:bg-zinc-800/50 transition-colors">
                  <th scope="row" class="py-2.5 pl-5 md:pl-2 pr-3 text-left font-normal">
                    <%= link_to venue.name, venue_path(venue.key),
                          class: "font-bold text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm transition-colors" %>
                    <% if venue.closed? %>
                      <span class="ml-1 text-xs px-1.5 py-0.5 rounded bg-zinc-200 text-zinc-700 dark:bg-zinc-700 dark:text-zinc-200 whitespace-nowrap"><%= venue.status_text %></span>
                    <% end %>
                  </th>
                  <td class="py-2.5 px-3 whitespace-nowrap text-zinc-700 dark:text-zinc-300"><%= venue.venue_type_text %></td>
                  <td class="py-2.5 px-3 whitespace-nowrap text-zinc-700 dark:text-zinc-300"><%= venue.prefecture %></td>
                  <td class="py-2.5 px-3 whitespace-nowrap text-zinc-700 dark:text-zinc-300"><%= venue.area %></td>
                  <td class="py-2.5 px-3 <%= 'pr-5 md:pr-2' unless @trend_counts %> whitespace-nowrap text-right tabular-nums text-zinc-700 dark:text-zinc-300"><%= number_with_delimiter(venue.capacity) if venue.capacity %></td>
                  <% if @trend_counts %>
                    <td class="py-2.5 pl-3 pr-5 md:pr-2 whitespace-nowrap text-right tabular-nums text-zinc-700 dark:text-zinc-300"><%= @trend_counts[venue.id] %></td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="py-20 text-center text-zinc-500 dark:text-zinc-400 font-bold">該当する会場が見つかりませんでした。</p>
      <% end %>

      <div class="mt-8 flex justify-center">
        <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
      </div>
    </div>
  </div>
</div>
