<% content_for :title, "会場一覧" %>
<%
  # 都道府県を選ぶ画面（issue #1810）。会場のある都道府県は都道府県ページ（issue #1801）へのリンク、
  # 会場が0件の都道府県もリンクにせず薄く表示し、配置を常に同じにする
  item_base = "flex items-baseline justify-between gap-2 rounded-xl border px-3 py-2.5 text-sm font-bold"
  link_class = "#{item_base} bg-white text-zinc-800 border-zinc-300 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-300 dark:bg-zinc-800 dark:text-zinc-100 dark:border-zinc-600 dark:hover:bg-zinc-700 dark:hover:text-amber-400 dark:hover:border-amber-400 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-900"
  empty_class = "#{item_base} border-dashed bg-zinc-50 text-zinc-500 border-zinc-200 dark:bg-zinc-900 dark:text-zinc-400 dark:border-zinc-700"
  count_class = "text-xs font-normal tabular-nums opacity-80"
  regions = Venue::PREFECTURE_REGIONS.map { |region, prefectures| [region, prefectures.map { |p| [p, @prefecture_counts[p].to_i, venue_prefecture_path(p)] }] }
  regions << ["その他", [["都道府県未設定", @unassigned_count, venue_prefecture_path(Venue::UNASSIGNED_PREFECTURE)]]]
%>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <div class="p-5 md:p-8 relative">
      <%# ヘッダーはユニット・個人の一覧（UNITS / PEOPLE）と揃える。色はProfileHeaderComponentの会場の色（teal）に合わせる %>
      <header class="mb-8 text-center flex flex-col items-center">
        <h1 class="text-3xl font-black text-zinc-800 dark:text-zinc-100 flex items-center justify-center gap-3">
          <span class="text-teal-700 dark:text-teal-400">VENUES</span>
          <span class="text-zinc-500 dark:text-zinc-400 text-lg font-bold"><%= @total_count %> records</span>
        </h1>
        <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">都道府県を選ぶと、その地域の会場を地図と一覧で見られます。</p>
      </header>

      <nav aria-label="都道府県から会場を探す" class="space-y-6">
        <% regions.each_with_index do |(region, prefectures), index| %>
          <section aria-labelledby="venue-region-<%= index %>">
            <h2 id="venue-region-<%= index %>" class="text-sm font-bold text-zinc-600 dark:text-zinc-300 mb-2 border-b border-zinc-200 dark:border-zinc-800 pb-1"><%= region %></h2>
            <ul class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2">
              <% prefectures.each do |name, count, path| %>
                <li>
                  <% if count.positive? %>
                    <%= link_to path, class: link_class do %>
                      <span><%= name %></span><span class="<%= count_class %>"><%= count %><span class="sr-only">件</span></span>
                    <% end %>
                  <% else %>
                    <span class="<%= empty_class %>">
                      <span><%= name %></span><span class="<%= count_class %>">0<span class="sr-only">件（会場なし）</span></span>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </nav>

      <%# 会場の投稿フォーム（issue #1814）への導線 %>
      <p class="mt-8 text-center text-sm text-zinc-600 dark:text-zinc-300">
        お探しの会場が見つかりませんか？
        <%= link_to "会場の情報を投稿する", new_venue_submission_path, class: "font-bold text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm" %>
      </p>
    </div>
  </div>
</div>
