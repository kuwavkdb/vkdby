<% content_for :title, name_with_kana(@venue.name, @venue.name_kana) %>
<%
  badge_link_class = "inline-block px-2 py-0.5 rounded text-sm font-semibold bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900 dark:text-indigo-200 dark:hover:bg-indigo-800 transition-colors mr-1 border border-indigo-200 dark:border-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400"
  link_class = "text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm"
  # name_logは現在の名前も含む名前の履歴。旧名として表示するのは現在の名前以外
  former_names = @venue.name_logs.reject { |log| log.name.blank? || log.name == @venue.name }
%>
<%# サイドバーはユニット・個人のページと共通 %>
<%= render layout: 'shared/with_sidebar' do %>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full min-w-0 max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <%# ヘッダーはユニット・個人のプロフィールページと共通（会場は専用の色、issue #1691） %>
    <%= render ProfileHeaderComponent.new(resource: @venue) %>

    <div class="p-5 md:p-8 grid gap-8 grid-cols-1 md:grid-cols-[minmax(220px,350px)_minmax(350px,1fr)] items-start">
      <div>
        <%# 基本情報の表示はユニット・個人の BasicAttributesComponent に揃える（issue #1691） %>
        <section class="@container mb-8">
          <h2 class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-300 mb-6 border-b border-zinc-200 dark:border-zinc-800 pb-2">基本情報</h2>
          <%
            badge_class = "inline-block whitespace-nowrap bg-indigo-50 dark:bg-indigo-900/50 text-indigo-600 dark:text-indigo-200 px-2 py-0.5 rounded text-xs font-bold hover:bg-indigo-100 dark:hover:bg-indigo-900/70 transition-colors border border-indigo-200 dark:border-indigo-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500"
            compact_items = []
            # 種別は都道府県ページ（都道府県未設定なら未設定の一覧）の種別の絞り込み（issue #1810）、
            # 都道府県・エリアは都道府県ページ・エリアページ（issue #1801）へのリンクにする。URLを作れない値はリンクなし
            compact_items << { label: "種別", value: link_to(@venue.venue_type_text, venue_type_page_path(@venue), class: badge_class) }
            compact_items << { label: "ステータス", value: tag.span(@venue.status_text, class: "whitespace-nowrap bg-zinc-100 dark:bg-zinc-800 px-3 py-1 rounded text-xs font-bold text-zinc-600 dark:text-zinc-300") }
            if @venue.prefecture.present?
              prefecture_path = venue_area_page_path(@venue.prefecture)
              compact_items << { label: "都道府県", value: prefecture_path ? link_to(@venue.prefecture, prefecture_path, class: badge_class) : @venue.prefecture }
              if @venue.area.present?
                area_path = venue_area_page_path(@venue.prefecture, @venue.area)
                compact_items << { label: "エリア", value: area_path ? link_to(@venue.area, area_path, class: badge_class) : @venue.area }
              end
            elsif @venue.area.present?
              compact_items << { label: "エリア", value: @venue.area }
            end
            compact_items << { label: "キャパシティ", value: number_with_delimiter(@venue.capacity) } if @venue.capacity
          %>
          <dl class="grid grid-cols-1 @[20rem]:grid-cols-2 gap-x-6 gap-y-3">
            <%= render BasicAttributeItemComponent.with_collection(compact_items) %>
          </dl>
          <%# 地図（issue #1781）。住所の上に表示する。住所のある会場のみ。Googleマップで開く導線は地図内にあるため別途リンクは置かない。
              dl の中には置けないため、基本情報の dl を地図の前後で分ける %>
          <% if (map_query = @venue.map_query) %>
            <div class="my-3">
              <% if @venue.closed? %>
                <p class="text-xs text-zinc-500 dark:text-zinc-400 mb-2">閉店した会場のため、現在は別の施設になっている場合があります。</p>
              <% end %>
              <div class="aspect-[4/3] w-full overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800">
                <iframe src="<%= google_maps_embed_url(map_query) %>"
                        title="<%= @venue.name %>の地図"
                        class="w-full h-full border-0"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen></iframe>
              </div>
            </div>
          <% end %>
          <dl class="mt-3 grid grid-cols-1 gap-y-3">
            <% if (display_address = @venue.display_address) %>
              <div class="flex flex-row justify-between items-baseline border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <dt class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 whitespace-nowrap mr-3">住所</dt>
                <dd class="text-sm font-bold text-zinc-900 dark:text-zinc-100 text-right"><%= display_address %></dd>
              </div>
            <% end %>
            <% if former_names.any? %>
              <div class="flex flex-row justify-between items-baseline border-b border-zinc-100 dark:border-zinc-800 pb-3">
                <dt class="text-sm font-semibold text-zinc-500 dark:text-zinc-400 whitespace-nowrap mr-3">旧名</dt>
                <dd class="text-sm font-bold text-zinc-900 dark:text-zinc-100 text-right">
                  <ul class="space-y-0.5">
                    <% former_names.each do |log| %>
                      <li>
                        <%= log.name %>
                        <% if log.date.present? %>
                          <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400">（<%= log.date %>〜）</span>
                        <% end %>
                      </li>
                    <% end %>
                  </ul>
                </dd>
              </div>
            <% end %>
          </dl>
          <% if @venue.note.present? %>
            <div class="mt-4 text-sm text-zinc-800 dark:text-zinc-200"><%= simple_format(@venue.note, {}, wrapper_tag: 'div') %></div>
          <% end %>
        </section>

        <%= render LinksComponent.new(links: @links) %>
        <%# 会場の情報の訂正の投稿（issue #1814） %>
        <p class="mt-6 text-sm"><%= link_to "この会場の情報の訂正を送る", new_venue_submission_path(venue_id: @venue.id), class: link_class %></p>
        <p class="mt-3 text-sm"><%= link_to "← 会場一覧へ", venues_path, class: link_class %></p>
      </div>

      <section aria-labelledby="venue-trends-heading">
        <h2 id="venue-trends-heading" class="text-sm font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-300 mb-2 border-b border-zinc-200 dark:border-zinc-700 pb-2">
          動向 <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400"><%= @pagy.count %> 件</span>
        </h2>
        <% if @trends.any? %>
          <ul>
            <% @trends.each do |trend| %>
              <li class="flex items-start gap-4 py-3 border-b border-zinc-200 dark:border-zinc-700 last:border-0">
                <div class="shrink-0 whitespace-nowrap text-zinc-600 dark:text-zinc-400 font-mono text-sm pt-0.5 font-bold">
                  <%= trend.date_label %>
                </div>
                <div class="grow">
                  <%# 個人名を件名の前に出す動向（Trend詳細と同じ判定、issue #1796）は、個人名 → ユニット名の順に並べる %>
                  <% if trend_show_person_badge_in_title?(trend) %>
                    <% trend.people.each do |person_data| %>
                      <% person = @related_people[person_data['person_id']] %>
                      <% display_name = trend_person_display_name(person_data, person) %>
                      <% if person %>
                        <%= link_to display_name, profile_path(person.key), class: badge_link_class %>
                      <% elsif display_name.present? %>
                        <%= unit_name_badge(display_name) %>
                      <% end %>
                    <% end %>
                  <% end %>
                  <% (trend.units || []).each do |unit_data| %>
                    <% unit = @related_units[unit_data['unit_id']] %>
                    <% display_name = trend_unit_display_name(unit_data, unit) %>
                    <%# 公開中のユニットはユニットのページへリンクする。見た目は/trends一覧のユニットバッジに揃える（issue #1782） %>
                    <% if unit %>
                      <%= link_to display_name, profile_path(unit.key), class: badge_link_class %>
                    <% elsif display_name.present? %>
                      <%= unit_name_badge(display_name) %>
                    <% end %>
                  <% end %>
                  <%= link_to format_wiki_title(trend.title, link: false), trend_path(trend),
                        class: "font-bold text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm transition-colors" %>
                </div>
              </li>
            <% end %>
          </ul>
          <div class="mt-6 flex justify-center">
            <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
          </div>
        <% else %>
          <p class="py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">この会場の動向はまだ登録されていません。</p>
        <% end %>
      </section>
    </div>

    <%# コメント欄（issue #1789）。ユニット・個人のページと同じDISQUSのパーシャル。
        old_keyがあれば旧サイトのURLを渡して過去コメントのスレッドを引き継ぐ %>
    <div class="px-5 md:px-8 pb-8">
      <%= render 'layouts/disqus', resource: @venue %>
    </div>
  </div>
</div>
<% end %>
