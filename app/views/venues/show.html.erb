<% content_for :title, name_with_kana(@venue.name, @venue.name_kana) %>
<%
  link_class = "text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm"
  # name_logは現在の名前も含む名前の履歴。旧名として表示するのは現在の名前以外
  former_names = @venue.name_logs.reject { |log| log.name.blank? || log.name == @venue.name }
  dt_class = "text-xs font-semibold text-zinc-500 dark:text-zinc-400"
  dd_class = "text-sm text-zinc-800 dark:text-zinc-200 mt-0.5"
%>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <%# ヘッダーはユニット・個人のプロフィールページと共通（会場は専用の色、issue #1691） %>
    <%= render ProfileHeaderComponent.new(resource: @venue) %>

    <div class="p-5 md:p-8 grid gap-8 grid-cols-1 md:grid-cols-[minmax(220px,320px)_1fr] items-start">
      <div>
        <dl class="space-y-3">
          <%# 種別・地域は一覧の絞り込みへのリンクにする %>
          <div>
            <dt class="<%= dt_class %>">種別</dt>
            <dd class="<%= dd_class %> flex flex-wrap items-center gap-1.5">
              <%= link_to @venue.venue_type_text, venues_path(venue_type: @venue.venue_type), class: link_class %>
              <% unless @venue.active? %>
                <span class="text-xs font-bold px-2 py-0.5 rounded bg-zinc-700 text-white dark:bg-zinc-200 dark:text-zinc-900"><%= @venue.status_text %></span>
              <% end %>
            </dd>
          </div>
          <% if @venue.prefecture.present? || @venue.address.present? %>
            <div>
              <dt class="<%= dt_class %>">所在地</dt>
              <dd class="<%= dd_class %>">
                <% if @venue.prefecture.present? %>
                  <div class="flex flex-wrap items-center gap-x-1.5">
                    <%= link_to @venue.prefecture, venues_path(prefecture: @venue.prefecture), class: link_class %>
                    <% if @venue.area.present? %>
                      <%= link_to @venue.area, venues_path(prefecture: @venue.prefecture, area: @venue.area), class: link_class %>
                    <% end %>
                  </div>
                <% elsif @venue.area.present? %>
                  <div><%= @venue.area %></div>
                <% end %>
                <% if @venue.address.present? %><div><%= @venue.address %></div><% end %>
              </dd>
            </div>
          <% end %>
          <% if @venue.capacity %>
            <div>
              <dt class="<%= dt_class %>">キャパシティ</dt>
              <dd class="<%= dd_class %>"><%= number_with_delimiter(@venue.capacity) %></dd>
            </div>
          <% end %>
          <% if former_names.any? %>
            <div>
              <dt class="<%= dt_class %>">旧名</dt>
              <dd class="<%= dd_class %>">
                <ul class="space-y-0.5">
                  <% former_names.each do |log| %>
                    <li>
                      <%= log.name %>
                      <% if log.date.present? %>
                        <span class="text-xs text-zinc-500 dark:text-zinc-400">（<%= log.date %>〜）</span>
                      <% end %>
                    </li>
                  <% end %>
                </ul>
              </dd>
            </div>
          <% end %>
          <% if @venue.note.present? %>
            <div>
              <dt class="<%= dt_class %>">メモ</dt>
              <dd class="<%= dd_class %>"><%= simple_format(@venue.note, {}, wrapper_tag: 'div') %></dd>
            </div>
          <% end %>
        </dl>
        <%= render LinksComponent.new(links: @links) %>
        <p class="mt-6 text-sm"><%= link_to "← 会場一覧へ", venues_path, class: link_class %></p>
      </div>

      <section aria-labelledby="venue-trends-heading">
        <h2 id="venue-trends-heading" class="text-sm font-bold uppercase tracking-wider text-zinc-600 dark:text-zinc-300 mb-2 border-b border-zinc-200 dark:border-zinc-700 pb-2">
          動向 <span class="text-xs font-normal text-zinc-500 dark:text-zinc-400"><%= @pagy.count %> 件</span>
        </h2>
        <% if @trends.any? %>
          <ul>
            <% @trends.each do |trend| %>
              <li class="flex items-start gap-4 py-3 border-b border-zinc-200 dark:border-zinc-700 last:border-0">
                <div class="shrink-0 whitespace-nowrap text-zinc-600 dark:text-zinc-400 font-mono text-sm pt-0.5 font-bold">
                  <%= trend.date_label %>
                </div>
                <div class="grow">
                  <% (trend.units || []).each do |unit_data| %>
                    <% unit = @related_units[unit_data['unit_id']] %>
                    <% display_name = trend_unit_display_name(unit_data, unit) %>
                    <%# 公開中のユニットはユニットのページへリンクする。見た目は/trends一覧のユニットバッジに揃える（issue #1782） %>
                    <% if unit %>
                      <%= link_to display_name, profile_path(unit.key), class: "inline-block px-2 py-0.5 rounded text-sm font-semibold bg-indigo-50 text-indigo-600 hover:bg-indigo-100 dark:bg-indigo-900 dark:text-indigo-200 dark:hover:bg-indigo-800 transition-colors mr-1 border border-indigo-200 dark:border-indigo-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400" %>
                    <% elsif display_name.present? %>
                      <%= unit_name_badge(display_name) %>
                    <% end %>
                  <% end %>
                  <%= link_to format_wiki_title(trend.title, link: false), trend_path(trend),
                        class: "font-bold text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm transition-colors" %>
                </div>
              </li>
            <% end %>
          </ul>
          <div class="mt-6 flex justify-center">
            <%== pagy_tailwind_nav(@pagy) if @pagy.pages > 1 %>
          </div>
        <% else %>
          <p class="py-8 text-center text-sm text-zinc-500 dark:text-zinc-400">この会場の動向はまだ登録されていません。</p>
        <% end %>
      </section>
    </div>
  </div>
</div>
