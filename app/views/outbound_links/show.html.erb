<%# 外部サイトへ遷移する前のクッションページ（issue #1823）。@destination_url は ExternalUrl.sanitize 済み %>
<% content_for :title, "#{@destination_host} へ移動します" %>
<% content_for :head do %>
  <meta name="robots" content="noindex, nofollow">
<% end %>
<%# 遷移のためのページにはAdSenseを掲載できない（ポリシー）ため、AdSenseは読み込まずMicroAdの広告を出す %>
<% content_for :disable_adsense, true %>
<% focus_ring = "focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-500 dark:focus-visible:outline-amber-400" %>

<div class="max-w-2xl mx-auto px-4 sm:px-0">
  <div class="bg-white dark:bg-zinc-900 rounded-lg border border-zinc-200 dark:border-zinc-800 p-5 md:p-8">
    <h1 class="text-lg font-bold text-zinc-900 dark:text-zinc-100">外部サイトへ移動します</h1>
    <p class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
      以下のボタンから <strong class="font-mono break-all"><%= @destination_host %></strong> へ移動します。
      移動先は<%= Rails.application.config.site_name %>が運営するサイトではありません。
    </p>

    <% if @item %>
      <div class="mt-5 flex gap-4 items-center">
        <% if @item.image_url.present? %>
          <% img_src = amazon_image?(@item.image_url) ? amazon_image_url(@item.image_url, 160) : @item.image_url %>
          <img src="<%= img_src %>" width="96" height="96" alt="<%= @item.title %>"
               class="w-24 h-24 shrink-0 object-scale-down bg-zinc-50 dark:bg-zinc-950">
        <% end %>
        <div class="min-w-0">
          <p class="font-bold text-zinc-900 dark:text-zinc-100 break-words"><%= @item.title %></p>
          <% artist_labels = @item.artists.map { |a| a['alias'].presence || a['name'] }.reject(&:blank?) %>
          <% if artist_labels.any? %>
            <p class="text-sm text-zinc-600 dark:text-zinc-300 break-words"><%= artist_labels.join(' / ') %></p>
          <% end %>
          <p class="text-sm text-zinc-500 dark:text-zinc-400 font-mono">
            <%= @item.release_date.strftime('%Y/%m/%d') %> <%= @item.release_date.future? ? '発売予定' : '発売' %>
          </p>
        </div>
      </div>
    <% end %>

    <%# 広告は販売ページへの導線（移動ボタン）の上に置く %>
    <div class="mt-6">
      <%= render "layouts/microad", spot: "94bb9f57ae4261d516924e994e46cd06" %>
    </div>

    <div class="mt-6 flex flex-col sm:flex-row gap-3">
      <%= link_to @destination_url, rel: "noopener noreferrer nofollow",
          class: "inline-flex items-center justify-center gap-2 px-5 py-3 font-bold rounded-lg transition-colors #{@item ? item_purchase_color_class(@item) : 'bg-teal-700 hover:bg-teal-800 text-white'} #{focus_ring}" do %>
        <%= @destination_host %> へ進む
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0" aria-hidden="true">
          <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 0 0-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 0 0 .75-.75v-4a.75.75 0 0 1 1.5 0v4A2.25 2.25 0 0 1 12.75 17h-8.5A2.25 2.25 0 0 1 2 14.75v-8.5A2.25 2.25 0 0 1 4.25 4h5a.75.75 0 0 1 0 1.5h-5Z" clip-rule="evenodd" />
          <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 0 0 1.06.053L16.5 4.44v2.81a.75.75 0 0 0 1.5 0v-4.5a.75.75 0 0 0-.75-.75h-4.5a.75.75 0 0 0 0 1.5h2.553l-9.056 8.194a.75.75 0 0 0-.053 1.06Z" clip-rule="evenodd" />
        </svg>
      <% end %>
      <% if @item %>
        <%= link_to "アイテムページに戻る", item_path(@item),
            class: "inline-flex items-center justify-center px-5 py-3 rounded-lg border border-zinc-300 dark:border-zinc-700 text-zinc-700 dark:text-zinc-200 hover:text-indigo-700 dark:hover:text-amber-400 transition-colors #{focus_ring}" %>
      <% end %>
    </div>
    <p class="mt-3 text-xs text-zinc-500 dark:text-zinc-400 font-mono break-all"><%= @destination_url %></p>
  </div>
</div>
