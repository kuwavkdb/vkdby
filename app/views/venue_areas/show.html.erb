<% place = [@prefecture, @area].compact.join(" ") %>
<% content_for :title, "#{place}の会場" %>
<%
  chip_class = "inline-block px-3 py-1.5 rounded-full text-sm font-bold transition-colors whitespace-nowrap border bg-white text-zinc-600 border-zinc-300 hover:bg-zinc-50 hover:text-indigo-700 dark:bg-zinc-800 dark:text-zinc-300 dark:border-zinc-600 dark:hover:bg-zinc-700 dark:hover:text-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-zinc-900"
  link_class = "text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 dark:focus-visible:ring-amber-400 rounded-sm"
%>
<%# 都道府県ページ・エリアページ（issue #1801）。範囲内の会場を地図と一覧で表示する %>
<div class="flex justify-center">
  <div class="bg-white dark:bg-zinc-900 shadow-2xl rounded-none md:rounded-3xl overflow-hidden w-full max-w-5xl animate-in slide-in-from-bottom-5 duration-700">
    <div class="p-5 md:p-8 relative">
      <nav aria-label="パンくずリスト" class="mb-4 text-sm text-zinc-600 dark:text-zinc-400">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li><%= link_to "会場一覧", venues_path, class: link_class %></li>
          <li aria-hidden="true" class="text-zinc-400">/</li>
          <% if @area %>
            <li><%= link_to @prefecture, venue_prefecture_path(@prefecture), class: link_class %></li>
            <li aria-hidden="true" class="text-zinc-400">/</li>
            <li aria-current="page" class="font-bold text-zinc-800 dark:text-zinc-100"><%= @area %></li>
          <% else %>
            <li aria-current="page" class="font-bold text-zinc-800 dark:text-zinc-100"><%= @prefecture %></li>
          <% end %>
        </ol>
      </nav>

      <%# ヘッダーは会場一覧（VENUES）と揃える %>
      <header class="mb-8 text-center flex flex-col items-center">
        <h1 class="text-3xl font-black text-zinc-800 dark:text-zinc-100 flex flex-wrap items-center justify-center gap-x-3 gap-y-1">
          <span class="text-teal-700 dark:text-teal-400"><%= place %></span>
          <span class="text-zinc-500 dark:text-zinc-400 text-lg font-bold"><%= @venues.size %> venues</span>
        </h1>
      </header>

      <% if @area_counts.present? %>
        <nav aria-label="エリア" class="mb-8">
          <h2 class="text-xs font-semibold text-zinc-500 dark:text-zinc-400 mb-1.5">エリア</h2>
          <ul class="flex flex-wrap gap-1.5">
            <% @area_counts.each do |area, count| %>
              <li>
                <%= link_to venue_area_path(@prefecture, area), class: chip_class do %>
                  <%= area %><span class="ml-1 text-xs font-normal opacity-80">(<%= count %>)</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </nav>
      <% end %>

      <%# 地図にプロットできる会場（座標あり・閉店と配信以外）がないときは地図を出さない。
          地図ライブラリはJavaScript側のアダプターが受け持ち、ここでは会場データを渡すだけにする %>
      <% if @map_venues.any? %>
        <section class="mb-8" aria-labelledby="venue-area-map-heading">
          <h2 id="venue-area-map-heading" class="sr-only">地図</h2>
          <div class="isolate"
               data-controller="venue-map"
               data-venue-map-provider-value="<%= VenueMapHelper::VENUE_MAP_PROVIDER %>"
               data-venue-map-venues-value="<%= venue_map_data(@map_venues).to_json %>"
               data-venue-map-options-value="<%= venue_map_options.to_json %>">
            <div data-venue-map-target="canvas"
                 role="region"
                 aria-label="<%= place %>の会場の地図（<%= @map_venues.size %>件）"
                 class="h-80 md:h-[28rem] w-full overflow-hidden rounded-xl border border-zinc-200 dark:border-zinc-700 bg-zinc-100 dark:bg-zinc-800"></div>
            <p data-venue-map-target="error" hidden class="mt-2 text-sm text-zinc-600 dark:text-zinc-300">
              地図を読み込めませんでした。会場は下の一覧から確認できます。
            </p>
          </div>
          <p class="mt-2 text-xs text-zinc-500 dark:text-zinc-400">
            地図には位置のわかる会場（閉店した会場を除く）を表示しています。すべての会場は下の一覧をご覧ください。
          </p>
        </section>
      <% end %>

      <section aria-labelledby="venue-area-list-heading">
        <h2 id="venue-area-list-heading" class="text-sm font-bold uppercase tracking-widest text-zinc-600 dark:text-zinc-300 mb-4 border-b border-zinc-200 dark:border-zinc-800 pb-2">会場一覧</h2>
        <%= render "venues/table", venues: @venues, trend_counts: @trend_counts %>
      </section>
    </div>
  </div>
</div>
