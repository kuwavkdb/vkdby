<section class="mt-12">
  <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-6 border-b border-slate-200 dark:border-slate-700 pb-2">リンク</h2>
  <ul class="grid gap-3">
    <% @links.each do |link| %>
      <% icon = link_icon(link) %>
      <li>
        <%= link_to link.url, target: "_blank", rel: "noopener", class: "group block p-4 bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-700 rounded-xl hover:border-unit dark:hover:border-amber-400 hover:scale-[1.02] transition-all relative pr-12" do %>
          <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-unit dark:group-hover:text-amber-400 break-all"><%= link.display_text %></span>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 transition-all text-slate-500 dark:text-slate-300 group-hover:text-unit dark:group-hover:text-amber-400">
            <%= sns_icon(icon) %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
