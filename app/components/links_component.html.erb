<section class="mt-12">
  <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-6 border-b border-slate-200 dark:border-slate-700 pb-2">リンク</h2>
  <ul class="grid gap-3">
    <% @links.each do |link| %>
      <% icon = link_icon(link) %>
      <li>
        <%= link_to link.url, target: "_blank", rel: "noopener", class: "group block p-4 bg-slate-50 dark:bg-slate-900/50 border border-slate-100 dark:border-slate-700 rounded-xl hover:border-unit dark:hover:border-amber-400 hover:scale-[1.02] transition-all relative pr-12" do %>
          <span class="text-sm font-bold text-slate-800 dark:text-slate-200 group-hover:text-unit dark:group-hover:text-amber-400 break-all"><%= link.display_text %></span>
          <span class="absolute right-4 top-1/2 -translate-y-1/2 transition-all text-slate-500 dark:text-slate-300 group-hover:text-unit dark:group-hover:text-amber-400">
            <% case icon %>
            <% when :x %>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
            <% when :instagram %>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2c2.717 0 3.056.01 4.122.06 1.065.05 1.79.217 2.428.465.66.256 1.216.6 1.772 1.153a4.908 4.908 0 011.153 1.772c.247.637.415 1.363.465 2.428.047 1.066.06 1.405.06 4.122 0 2.717-.01 3.056-.06 4.122-.05 1.065-.218 1.79-.465 2.428a4.883 4.883 0 01-1.153 1.772 4.915 4.915 0 01-1.772 1.153c-.637.247-1.363.415-2.428.465-1.066.047-1.405.06-4.122.06-2.717 0-3.056-.01-4.122-.06-1.065-.05-1.79-.218-2.428-.465a4.89 4.89 0 01-1.772-1.153 4.904 4.904 0 01-1.153-1.772c-.248-.637-.415-1.363-.465-2.428C2.013 15.056 2 14.717 2 12c0-2.717.01-3.056.06-4.122.05-1.066.217-1.79.465-2.428a4.9 4.9 0 011.153-1.772A4.898 4.898 0 015.45 2.525c.638-.248 1.362-.415 2.428-.465C8.944 2.013 9.283 2 12 2zm0 5a5 5 0 100 10 5 5 0 000-10zm0 8.25a3.25 3.25 0 110-6.5 3.25 3.25 0 010 6.5zm5.25-9.575a1.2 1.2 0 100 2.4 1.2 1.2 0 000-2.4z" />
              </svg>
            <% when :youtube %>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            <% when :tiktok %>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M16.6 5.82c-1.005-1.06-1.56-2.44-1.56-3.82h-3.13v14.57a2.6 2.6 0 01-4.65 1.58 2.6 2.6 0 011.94-4.32c.24 0 .47.03.69.09V10.8a5.8 5.8 0 00-.69-.04A5.77 5.77 0 003 16.53a5.77 5.77 0 0010.87 2.7 5.7 5.7 0 00.82-3V8.9a8.5 8.5 0 004.96 1.59V7.36c-1.06 0-2.05-.4-2.79-1.13a5.4 5.4 0 01-.26-.41z" />
              </svg>
            <% when :spotify %>
              <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424a.624.624 0 01-.858.208c-2.35-1.436-5.305-1.76-8.786-.964a.622.622 0 11-.277-1.215c3.809-.871 7.077-.496 9.713 1.113a.623.623 0 01.208.858zm1.223-2.722a.78.78 0 01-1.072.257c-2.69-1.653-6.79-2.133-9.974-1.167a.781.781 0 11-.453-1.494c3.638-1.104 8.157-.568 11.242 1.332a.78.78 0 01.257 1.072zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71a.936.936 0 11-.543-1.79c3.533-1.072 9.404-.865 13.115 1.338a.936.936 0 01-.955 1.61z" />
              </svg>
            <% else %>
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-6 h-6" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.25 5.5a.75.75 0 00-.75.75v8.5c0 .414.336.75.75.75h8.5a.75.75 0 00.75-.75v-4a.75.75 0 011.5 0v4A2.25 2.25 0 0112.75 17h-8.5A2.25 2.25 0 012 14.75v-8.5A2.25 2.25 0 014.25 4h5a.75.75 0 010 1.5h-5z" clip-rule="evenodd" />
                <path fill-rule="evenodd" d="M6.194 12.753a.75.75 0 001.06.053L16.5 4.44v2.81a.75.75 0 001.5 0v-4.5a.75.75 0 00-.75-.75h-4.5a.75.75 0 000 1.5h2.553l-9.056 8.194a.75.75 0 00-.053 1.06z" clip-rule="evenodd" />
              </svg>
            <% end %>
            <span class="sr-only">(<%= icon ? link.sns_info[:platform] : "外部サイト" %>)</span>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</section>
