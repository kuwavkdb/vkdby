<% if @past_members.present? %>
  <section class="mb-12">
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300 mb-6 border-b border-slate-200 dark:border-slate-700 pb-2">過去のメンバー</h2>
    <div class="flex flex-col border border-slate-200 dark:border-slate-700 rounded-2xl overflow-hidden shadow-sm">
      <% @past_members.each do |up| %>
        <%= render MemberRowComponent.new(member: up, hide_left: true) %>
      <% end %>
    </div>
  </section>
<% end %>
