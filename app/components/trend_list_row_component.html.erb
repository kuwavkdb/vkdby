<% if current? %>
  <div class="flex items-start gap-3 text-sm">
    <%# 日付列は固定幅(w-24)だとAndroid標準の等幅フォント（総称フォントmonospaceが
        Roboto Mono等にフォールバックし、Menlo/Consolas等デスクトップ用より字幅が広い）で
        "YYYY/MM/DD"がはみ出し、gap-3の余白を食いつぶして隣列と間隔がなくなっていた。
        固定幅をやめてwhitespace-nowrapで折り返しのみ防止し、実際の描画幅に委ねる（issue #1322） %>
    <div class="shrink-0 whitespace-nowrap text-slate-400 dark:text-slate-500 font-mono text-sm pt-0.5 font-bold">
      <%= @trend.date.strftime('%Y/%m/%d') %>
    </div>
    <div class="grow">
      <p class="font-bold text-slate-400 dark:text-slate-500">
        <% unit_badges.each do |name| %>
          <span class="px-1.5 py-0.5 rounded text-[11px] align-middle bg-slate-100 dark:bg-slate-800 text-slate-400 dark:text-slate-500"><%= name %></span>
        <% end %>
        <%= format_wiki_title(@trend.title, link: false) %>
      </p>
    </div>
  </div>
<% else %>
  <%= link_to trend_path(@trend), class: "flex items-start gap-3 text-sm group" do %>
    <div class="shrink-0 whitespace-nowrap text-indigo-600 dark:text-indigo-400 font-mono text-sm pt-0.5 font-bold group-hover:text-indigo-500 transition-colors">
      <%= @trend.date.strftime('%Y/%m/%d') %>
    </div>
    <div class="grow">
      <p class="font-bold text-indigo-700 dark:text-indigo-300 underline decoration-indigo-600/25 dark:decoration-indigo-400/40 underline-offset-2 group-hover:decoration-indigo-600 dark:group-hover:decoration-indigo-400 transition-colors">
        <% unit_badges.each do |name| %>
          <span class="px-1.5 py-0.5 rounded text-[11px] align-middle bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 no-underline"><%= name %></span>
        <% end %>
        <%= format_wiki_title(@trend.title, link: false) %>
      </p>
    </div>
  <% end %>
<% end %>
