<div class="bg-white dark:bg-slate-800 p-3 border-b border-slate-100 dark:border-slate-700 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-900/40 transition-colors">
  <div>
    <div class="flex items-center justify-between gap-3 md:gap-4 flex-wrap sm:flex-nowrap">
      <div class="flex items-center gap-3 md:gap-4 flex-1">
        <span class="text-xs font-black text-slate-500 uppercase tracking-widest min-w-[4rem]" title="<%= (@member.part_alias.present? || @member.support?) ? @member.part.upcase : '' %>">
          <%= (@member.support? ? "サポート " : "") + (@member.part_alias.presence || @member.part.upcase) %>
        </span>
        <%# role="heading"のdivを使用（<h3>にしない）: {{member}}/{{member2}}/{{snapshot}}
            プラグイン経由でcustom_pages/show.html.erbの.markdown-content内に
            埋め込まれる際、グローバルな`.markdown-content h3`スタイル
            （margin: 1em 0 0.4em）が意図せず適用され、行の余白が大きく崩れるため %>
        <div role="heading" aria-level="3" class="text-base md:text-lg font-black text-slate-800 dark:text-slate-100">
          <% if @member.person && @member.person.key.present? %>
            <%# リンク色はサイト全体の標準（.markdown-content/.wiki-content a・trend_list_row_component
                と同じ、ライトはindigo-700・ダークはamber-400）に統一している（issue #1322, #1571） %>
            <%= link_to @member.name, profile_path(@member.person.key), class: "text-indigo-700 dark:text-amber-400 underline decoration-indigo-600/25 dark:decoration-amber-400/40 underline-offset-2 hover:decoration-indigo-600 dark:hover:decoration-amber-400 transition-colors" %>
          <% else %>
            <%= @member.name %>
          <% end %>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <% if @member.sns.present? && @member.sns.is_a?(Array) %>
          <% @member.sns.each do |sns_account| %>
            <%= link_to sns_url_for(sns_account), target: "_blank", rel: "noopener noreferrer", class: "inline-flex items-center text-slate-500 dark:text-slate-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors" do %>
              <%= sns_icon(sns_icon_for(sns_account), css_class: "w-4 h-4") %>
            <% end %>
          <% end %>
        <% end %>
        <% if show_status? %>
          <span class="<%= status_classes %>">
            <%= @member.status %>
          </span>
        <% end %>
      </div>
    </div>
    <% if (p_items = person_history_items).present? %>
      <div class="mt-3 pl-4 flex flex-col" data-toggle-target="content">
        <%= render HistoryRowComponent.with_collection(p_items) %>
      </div>
    <% end %>
  </div>
</div>
