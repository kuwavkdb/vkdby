<section class="mb-12">
  <h2 class="text-xs font-bold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-6 border-b border-slate-200 dark:border-slate-700 pb-2">Lineup Snapshots</h2>

  <div class="flex flex-col gap-6">
    <% @snapshots.each do |snapshot| %>
      <div class="border border-slate-200 dark:border-slate-700 rounded-2xl overflow-hidden shadow-sm">
        <div class="bg-slate-50 dark:bg-slate-900/50 px-5 py-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-slate-700 dark:text-slate-200"><%= snapshot.display_label %></span>
            <span class="text-xs text-slate-400 dark:text-slate-500"><%= snapshot.snapshot_date.strftime('%Y/%m/%d') %></span>
          </div>
          <% if snapshot.current? %>
            <span class="text-[0.65rem] font-black uppercase px-2 py-0.5 rounded-md bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400">Current</span>
          <% end %>
        </div>
        <div class="flex flex-col">
          <% snapshot.snapshot_people.sort_by(&:sort_order).each do |sp| %>
            <div class="bg-white dark:bg-slate-800 p-4 border-b border-slate-100 dark:border-slate-700 last:border-0 hover:bg-slate-50 dark:hover:bg-slate-900/40 transition-colors">
              <div class="flex items-center gap-3 md:gap-4">
                <span class="text-xs font-black text-slate-400 dark:text-slate-500 uppercase tracking-widest min-w-[4rem]">
                  <%= sp.part %>
                </span>
                <h3 class="text-base font-black text-slate-800 dark:text-slate-100">
                  <% if sp.person&.key.present? %>
                    <%= link_to sp.name, profile_path(sp.person.key), class: "hover:text-person transition-colors" %>
                  <% else %>
                    <%= sp.name %>
                  <% end %>
                </h3>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</section>
