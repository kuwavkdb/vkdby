<section class="<%= 'mt-8' if @top_spacing %>">
  <div class="flex items-center justify-between mb-4 border-b border-slate-200 dark:border-slate-700 pb-2">
    <h2 class="text-sm font-bold uppercase tracking-wider text-slate-600 dark:text-slate-300">動向</h2>
  </div>

  <div class="space-y-3">
    <% @trends.each do |trend| %>
      <%= render TrendListRowComponent.new(trend: trend, current: current?(trend), resource: @resource, related_units: @related_units) %>
    <% end %>
  </div>
</section>
