<%= link_to profile_path(@person.key), class: card_classes do %>
  <div class="absolute top-0 right-0 <%= icon_padding_classes %> opacity-10 group-hover:opacity-20 transition-opacity">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="<%= icon_size_classes %>">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
    </svg>
  </div>
  <div class="relative z-10">
    <h3 class="<%= name_classes %>"><%= @person.name %></h3>
    <% if @person.name_kana.present? %>
      <p class="<%= kana_classes %>"><%= @person.name_kana %></p>
    <% end %>
    <%= content %>
  </div>
<% end %>
